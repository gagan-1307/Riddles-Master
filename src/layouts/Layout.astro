---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
	title?: string;
	description?: string;
	hideNavbar?: boolean;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
}

const {
	title = "Riddles Master",
	description = "Master your technical interview with curated riddles, logic puzzles, and brain teasers from tech companies.",
	hideNavbar = false,
	ogImage,
	ogType = "website",
	canonicalUrl,
} = Astro.props;

const { user, role } = Astro.locals;
const serializedUser = user
	? {
			id: user.id,
			email: user.email || "",
			name:
				user.user_metadata?.full_name ||
				user.user_metadata?.name ||
				null,
			avatarUrl:
				user.user_metadata?.avatar_url ||
				user.user_metadata?.avatarUrl ||
				null,
		}
	: null;

const resolvedCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.url.origin).toString();
const resolvedOgImage = ogImage || new URL("/og-image.png", Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YBGJZZ8BNT"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-YBGJZZ8BNT');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<!-- Preload Critical Fonts -->
		<link
			rel="preload"
			href="/fonts/geist-sans-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/geist-mono-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Riddles" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={resolvedCanonicalUrl} />

		<!-- OpenGraph Meta Tags -->
		<meta property="og:site_name" content="RiddlesMaster" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={resolvedCanonicalUrl} />
		<meta property="og:image" content={resolvedOgImage} />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />


		<slot name="head" />
		<SpeedInsights />
		<Analytics />
	</head>
	<body class="min-h-screen bg-canvas-soft font-geist text-ink antialiased">
		{!hideNavbar && <Navbar user={serializedUser} role={role} />}
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--font-geist:
			"Geist Variable", "Inter Variable", system-ui, -apple-system, sans-serif;
		--font-mono:
			"Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Custom selection color */
	::selection {
		background-color: #000;
		color: #fff;
	}
</style>
