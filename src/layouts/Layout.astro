---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "RiddlesMaster | Technical Puzzles & Brain Teasers",
	description = "Master your technical interview with curated riddles, logic puzzles, and brain teasers from top tech companies."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-geist: "Inter", system-ui, -apple-system, sans-serif;
		--font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
