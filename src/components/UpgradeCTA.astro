---
import { Lock } from 'lucide-react';
---

<div class="rounded-lg border border-[#cc785c]/30 bg-[#faf9f5] p-8 text-center shadow-sm relative overflow-hidden transition-all hover:border-[#cc785c]/50">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#faf9f5]/20 pointer-events-none"></div>
  <div class="relative z-10 py-4 max-w-md mx-auto">
    <div class="mx-auto h-12 w-12 rounded-full bg-[#cc785c]/10 flex items-center justify-center text-[#cc785c] mb-4">
      <Lock className="h-6 w-6" />
    </div>
    <h3 class="text-xl font-bold text-[#141413] mb-3 font-serif">Detailed Editorial Solution is Premium</h3>
    <p class="text-sm text-[#6c6a64] mb-6 leading-relaxed">
      Unlock detailed step-by-step mathematical proofs, logic explanations, and company-specific interview preparation pathways.
    </p>

    <div class="flex justify-center">
      <a
        href="/pricing"
        class="inline-flex h-10 items-center justify-center rounded-md bg-[#cc785c] px-6 text-sm font-semibold text-white transition-all hover:bg-[#a9583e] active:scale-[0.98] shadow-md shadow-[#cc785c]/10"
      >
        Unlock Editorial Solution
      </a>
    </div>
  </div>
</div>
