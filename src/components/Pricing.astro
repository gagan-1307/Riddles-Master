---
const plans = [
  {
    name: "Free",
    price: "₹0",
    description: "Perfect for casual practice.",
    features: [
      "5 questions / day",
      "View problem statements",
      "Daily streak tracking",
      "Community tags"
    ],
    cta: "Current Plan",
    featured: false,
  },
  {
    name: "Premium",
    price: "₹99",
    period: "/mo",
    description: "The complete interview prep toolkit.",
    features: [
      "Unlimited daily questions",
      "Full step-by-step solutions",
      "Access to all premium problems",
      "Company-wise filtered sets",
      "Priority new problem access"
    ],
    cta: "Upgrade to Pro",
    featured: true,
  },
  {
    name: "3 Months",
    price: "₹249",
    description: "Save ₹50 vs monthly billing.",
    features: [
      "Everything in Premium",
      "Save ₹50 vs monthly",
      "Best for intensive prep"
    ],
    cta: "Get 3 Months",
    featured: false,
  }
];
---

<section id="pricing" class="bg-canvas-soft py-24 sm:py-32">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="mb-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Plans for every stage.</h2>
      <p class="mt-4 text-lg text-body">Choose the plan that fits your interview preparation timeline.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {plans.map((plan) => (
        <div class={`relative flex flex-col rounded-xl border p-8 shadow-sm transition-all hover:shadow-md ${plan.featured ? 'border-primary bg-primary text-on-primary ring-1 ring-primary' : 'border-hairline bg-canvas text-ink'}`}>
          {plan.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-link text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">
              Most Popular
            </span>
          )}
          
          <div class="mb-8">
            <h3 class="text-xl font-bold">{plan.name}</h3>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
              {plan.period && <span class="text-sm opacity-80">{plan.period}</span>}
            </div>
            <p class={`mt-4 text-sm ${plan.featured ? 'text-on-primary/80' : 'text-body'}`}>{plan.description}</p>
          </div>

          <ul class="mb-8 space-y-4 flex-1">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm">
                <svg class={`h-5 w-5 shrink-0 ${plan.featured ? 'text-cyan' : 'text-link'}`} fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class={plan.featured ? 'text-on-primary/90' : 'text-body'}>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href="/signup"
            class={`block w-full rounded-full py-3 text-center text-sm font-semibold transition-opacity hover:opacity-90 ${plan.featured ? 'bg-canvas text-ink' : 'bg-primary text-on-primary'}`}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
    
    <p class="mt-12 text-center text-sm text-mute">
      All plans include daily streak tracking. Cancel anytime.
    </p>
  </div>
</section>
