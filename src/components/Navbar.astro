---
import { Image } from "astro:assets";
interface Props {
  user: {
    id: string;
    email: string;
    name?: string | null;
    avatarUrl?: string | null;
  } | null;
  role?: string;
}

const { user, role = "user" } = Astro.props;

const navLinks = [
  { href: "/problems", label: "Problems", icon: "question" },
  { href: "/daily", label: "Daily Riddle", icon: "calendar" },
  { href: "/practice", label: "Practice", icon: "target" },
  { href: "/exams", label: "Exams", icon: "trophy" },
  { href: "/articles", label: "Articles", icon: "book" },
  { href: "/pricing", label: "Pricing", icon: "card" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 w-full border-b border-[#e6dfd8] bg-[#faf9f5]/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-14 max-w-[1400px] items-center justify-between px-6"
  >
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 group">
        <img
          src="/favicon.svg"
          alt="RiddlesMaster"
          class="h-6 w-6 transition-transform group-hover:rotate-12"
        />
        <span class="text-[15px] font-bold tracking-[-0.03em] text-[#181715]"
          >RiddlesMaster</span
        >
      </a>

      <div class="hidden md:flex items-center gap-1.5">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-full px-3.5 py-2 text-[14px] font-semibold text-[#6c6a64] transition-colors hover:bg-[#efe9de]/30 hover:text-[#181715] flex items-center gap-1.5 decoration-none"
            >
              {link.icon === "question" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {link.icon === "calendar" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {link.icon === "target" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {link.icon === "trophy" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
              )}
              {link.icon === "book" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {link.icon === "card" && (
                <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              )}
              {link.label}
            </a>
          ))
        }
        {
          role === "admin" && (
            <a
              href="/admin"
              class="rounded-full px-3.5 py-2 text-[14px] font-bold text-violet-600 transition-colors hover:bg-violet-50 flex items-center gap-1.5 decoration-none"
            >
              <svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              Admin
            </a>
          )
        }
      </div>
    </div>

    <div class="flex items-center gap-3">
      {
        user ? (
          <div class="flex items-center gap-4">
            <div class="relative" id="profile-dropdown-container">
              <button
                id="profile-dropdown-btn"
                class="flex items-center gap-2 rounded-full px-3 py-1.5 text-[13px] font-medium text-[#181715] transition-colors hover:bg-[#e6dfd8]/30 border border-[#e6dfd8] bg-[#faf9f5]"
              >
                <div class="h-5 w-5 rounded-full bg-[#181715]/5 flex items-center justify-center border border-[#e6dfd8] overflow-hidden">
                  {user.avatarUrl ? (
                    <Image
                      src={user.avatarUrl}
                      alt={user.name || "Avatar"}
                      width={20}
                      height={20}
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <span class="text-[10px] font-bold text-[#181715]/40 capitalize">
                      {user.email?.[0]}
                    </span>
                  )}
                </div>
                <span class="max-w-[100px] truncate">
                  {user.name || user.email?.split("@")[0]}
                </span>
                <svg
                  id="profile-dropdown-arrow"
                  class="h-4 w-4 text-[#6c6a64] transition-transform"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>

              <div
                id="profile-dropdown-menu"
                class="hidden absolute right-0 mt-2 w-48 origin-top-right rounded-md border border-[#e6dfd8] bg-[#faf9f5] py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
              >
                <div class="px-4 py-2 border-b border-[#e6dfd8] text-xs text-[#6c6a64] truncate">
                  Signed in as
                  <br />
                  <span class="font-semibold text-[#181715]">{user.email}</span>
                </div>
                <a
                  href="/profile"
                  class="block px-4 py-2 text-sm text-[#181715] hover:bg-[#e6dfd8]/30"
                >
                  Your Profile
                </a>
                {role === "admin" && (
                  <a
                    href="/admin"
                    class="block px-4 py-2 text-sm text-[#181715] hover:bg-[#e6dfd8]/30"
                  >
                    Admin Dashboard
                  </a>
                )}
                <form
                  action="/logout"
                  method="POST"
                  class="m-0 border-t border-[#e6dfd8]"
                >
                  <button
                    type="submit"
                    class="block w-full text-left px-4 py-2 text-sm text-[#c64545] hover:bg-red-50 border-none bg-transparent cursor-pointer"
                  >
                    Log Out
                  </button>
                </form>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex items-center gap-3">
            <a
              href="/login"
              class="rounded-full px-4 py-1.5 text-[13px] font-semibold text-[#6c6a64] hover:text-[#181715]"
            >
              Log In
            </a>
            <a
              href="/signup"
              class="rounded-full bg-[#cc785c] hover:bg-[#a9583e] px-4 py-1.5 text-[13px] font-semibold text-white shadow-lg shadow-[#cc785c]/10 transition-all hover:opacity-90 active:scale-[0.98]"
            >
              Sign Up
            </a>
          </div>
        )
      }

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex md:hidden items-center justify-center p-1.5 rounded-md text-[#6c6a64] hover:text-[#181715] hover:bg-[#e6dfd8]/30 transition-colors cursor-pointer"
        aria-label="Toggle Menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          id="mobile-menu-icon"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#e6dfd8] bg-[#faf9f5] px-6 py-4 space-y-2 shadow-inner animate-in fade-in slide-in-from-top-2 duration-200"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-2 text-[14px] font-medium text-[#6c6a64] hover:bg-[#e6dfd8]/30 hover:text-[#181715] transition-colors flex items-center gap-2 decoration-none"
        >
          {link.icon === "question" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
          {link.icon === "calendar" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
          {link.icon === "target" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
          {link.icon === "trophy" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          )}
          {link.icon === "book" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          )}
          {link.icon === "card" && (
            <svg class="h-5 w-5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          )}
          {link.label}
        </a>
      ))
    }
    {
      role === "admin" && (
        <a
          href="/admin"
          class="rounded-md px-3 py-2 text-[14px] font-bold text-violet-600 hover:bg-violet-50 transition-colors flex items-center gap-2 decoration-none"
        >
          <svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Admin Panel
        </a>
      )
    }
  </div>
</nav>

<script>
  // Register document-wide click listener once at script level
  document.addEventListener("click", (e) => {
    const container = document.getElementById("profile-dropdown-container");
    const menu = document.getElementById("profile-dropdown-menu");
    const arrow = document.getElementById("profile-dropdown-arrow");
    if (container && menu && arrow && !container.contains(e.target as Node)) {
      menu.classList.add("hidden");
      arrow.classList.remove("rotate-180");
    }
  });

  function setupNavbar() {
    // Profile dropdown toggling
    const btn = document.getElementById("profile-dropdown-btn");
    const menu = document.getElementById("profile-dropdown-menu");
    const arrow = document.getElementById("profile-dropdown-arrow");

    if (btn && menu && arrow) {
      btn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains("hidden");
        if (isOpen) {
          menu.classList.add("hidden");
          arrow.classList.remove("rotate-180");
        } else {
          menu.classList.remove("hidden");
          arrow.classList.add("rotate-180");
        }
      };
    }

    // Mobile menu toggling
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileMenuIcon = document.getElementById("mobile-menu-icon");

    if (mobileMenuBtn && mobileMenu && mobileMenuIcon) {
      mobileMenuBtn.onclick = () => {
        const isHidden = mobileMenu.classList.contains("hidden");
        if (isHidden) {
          mobileMenu.classList.remove("hidden");
          mobileMenuIcon.innerHTML = `
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          `;
        } else {
          mobileMenu.classList.add("hidden");
          mobileMenuIcon.innerHTML = `
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          `;
        }
      };
    }
  }

  // Run on initial load and after every page transition
  document.addEventListener('astro:page-load', setupNavbar);
</script>
