---
const { user, role } = Astro.locals;

const navLinks = [
  { href: "/problems", label: "Problems" },
  { href: "/daily", label: "Daily Riddle" },
  { href: "/pricing", label: "Pricing" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-[1400px] items-center justify-between px-6">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 group">
        <div class="h-6 w-6 rounded-md bg-ink flex items-center justify-center transition-transform group-hover:rotate-12">
          <span class="text-canvas text-[10px] font-bold">R</span>
        </div>
        <span class="text-[15px] font-bold tracking-[-0.03em] text-ink">RiddlesMaster</span>
      </a>
      
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-pill px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
          >
            {link.label}
          </a>
        ))}
        {role === 'admin' && (
          <a
            href="/admin"
            class="rounded-pill px-3 py-1.5 text-[13px] font-bold text-violet transition-colors hover:bg-violet/5"
          >
            Admin
          </a>
        )}
      </div>
    </div>

    <div class="flex items-center gap-3">
      {user ? (
        <div class="flex items-center gap-4">
          <a href="/profile" class="flex items-center gap-2 rounded-pill px-3 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-canvas-soft-2">
            <div class="h-5 w-5 rounded-full bg-ink/5 flex items-center justify-center border border-hairline">
              <span class="text-[10px] font-bold text-ink/40 capitalize">{user.email?.[0]}</span>
            </div>
            {user.email?.split('@')[0]}
          </a>
          <form action="/logout" method="POST" class="m-0">
            <button
              type="submit"
              class="rounded-pill border border-hairline bg-canvas px-4 py-1.5 text-[13px] font-semibold text-ink shadow-sm transition-all hover:bg-canvas-soft active:scale-[0.98]"
            >
              Log Out
            </button>
          </form>
        </div>
      ) : (
        <div class="flex items-center gap-3">
          <a
            href="/login"
            class="rounded-pill px-4 py-1.5 text-[13px] font-semibold text-body transition-colors hover:text-ink"
          >
            Log In
          </a>
          <a
            href="/signup"
            class="rounded-pill bg-ink px-4 py-1.5 text-[13px] font-semibold text-canvas shadow-lg shadow-ink/10 transition-all hover:opacity-90 active:scale-[0.98]"
          >
            Sign Up
          </a>
        </div>
      )}
    </div>
  </div>
</nav>
