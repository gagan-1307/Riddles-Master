---
import { getTodaysProblem } from '../lib/daily';
import { getUser } from '../lib/auth/getUser';
import { getStreakCount } from '../lib/auth/streak';

// Fetch the user session to check streak count
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;

let streakCount = null;
if (user) {
  streakCount = await getStreakCount(user.id);
}

const problem = await getTodaysProblem();
---

<div class="rounded-xl border border-[#e6dfd8] bg-[#efe9de]/40 p-8 sm:p-10 shadow-sm relative overflow-hidden">
  {/* Soft decorative background highlight */}
  <div class="absolute top-0 right-0 w-32 h-32 bg-[#cc785c]/5 rounded-bl-full pointer-events-none"></div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-[#e6dfd8] pb-6 mb-6">
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold uppercase tracking-wider text-[#6c6a64] bg-[#efe9de] px-3 py-1 rounded-md">
        Today's Daily Riddle
      </span>
      {problem && (
        <span class="text-xs font-semibold text-[#cc785c] bg-[#cc785c]/10 px-2.5 py-1 rounded-full border border-[#cc785c]/20">
          Riddle #{problem.number}
        </span>
      )}
    </div>
    {streakCount !== null && streakCount > 0 && (
      <div class="flex items-center gap-1.5 text-sm font-semibold text-[#cc785c] bg-[#cc785c]/10 px-3 py-1 rounded-full border border-[#cc785c]/20 w-fit">
        <svg class="h-4 w-4 fill-current animate-pulse text-[#cc785c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
        </svg>
        <span>{streakCount} Day Streak</span>
      </div>
    )}
  </div>

  {problem ? (
    <div>
      <h3 class="text-xl sm:text-2xl font-normal text-[#141413] font-serif mb-3">
        {problem.title}
      </h3>
      <p class="text-sm sm:text-base text-[#3d3d3a] leading-relaxed mb-6 italic">
        "{problem.statement.substring(0, 150)}..."
      </p>
      <div class="flex items-center justify-between">
        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold border ${
          problem.difficulty === 'EASY' ? 'bg-[#5db872]/10 text-[#2e7d32] border-[#5db872]/20' :
          problem.difficulty === 'MEDIUM' ? 'bg-[#e8a55a]/10 text-[#b26a00] border-[#e8a55a]/20' :
          'bg-[#c64545]/10 text-[#c64545] border-[#c64545]/20'
        }`}>
          {problem.difficulty}
        </span>
        <a
          href="/daily"
          class="inline-flex items-center gap-1.5 text-sm font-bold text-[#cc785c] hover:text-[#a9583e] transition-colors"
        >
          Solve It
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  ) : (
    <div class="text-center py-6 text-[#6c6a64] italic">
      No daily riddle is available for today. Check back later!
    </div>
  )}
</div>
