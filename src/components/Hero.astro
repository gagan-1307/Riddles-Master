---
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-canvas py-20">
  <!-- Mesh Gradient Background with deeper opacity and spread -->
  <div class="absolute inset-0 z-0">
    <div class="mesh-gradient absolute inset-0 opacity-[0.15] blur-[120px] scale-110"></div>
    <div class="absolute inset-0 bg-radial-[at_50%_50%,transparent_0%,white_70%] opacity-40"></div>
  </div>
  
  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="flex flex-col items-center text-center">
      <!-- Badge -->
      <div class="animate-in fade-in slide-in-from-top-4 duration-1000">
        <div class="mx-auto flex max-w-fit items-center gap-2 rounded-full border border-hairline bg-canvas/50 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-body shadow-sm">
          <span class="flex h-2 w-2 rounded-full bg-cyan animate-pulse"></span>
          <span class="text-ink/80 uppercase tracking-widest text-[10px]">v1.0 Live</span>
          <span class="h-3 w-[1px] bg-hairline"></span>
          <span>New logic puzzles added every 24h</span>
        </div>
      </div>
      
      <!-- Heading: Massive and Wide -->
      <h1 class="mt-10 max-w-5xl text-5xl font-black leading-[1.05] tracking-[-0.05em] text-ink sm:text-7xl lg:text-8xl animate-in fade-in slide-in-from-bottom-6 duration-1000 delay-100">
        Master the technical interview <span class="bg-gradient-to-r from-ink via-mute to-ink bg-clip-text text-transparent opacity-90">riddle.</span>
      </h1>
      
      <!-- Subtext: Wider and better leading -->
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-body sm:text-xl md:text-2xl animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-200">
        Stop failing the logic round. We've curated the most challenging lateral thinking puzzles from 
        <span class="font-bold text-ink underline decoration-hairline-strong underline-offset-4">Google</span>, 
        <span class="font-bold text-ink underline decoration-hairline-strong underline-offset-4">Amazon</span>, 
        and <span class="font-bold text-ink underline decoration-hairline-strong underline-offset-4">Top Tech</span> firms.
      </p>
      
      <!-- Actions: Premium Pill Buttons -->
      <div class="mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row animate-in fade-in slide-in-from-bottom-10 duration-1000 delay-300">
        <a href="/problems" class="group relative flex h-14 items-center justify-center rounded-full bg-ink px-10 text-base font-bold text-canvas shadow-2xl shadow-ink/20 transition-all hover:scale-[1.02] hover:shadow-ink/30 active:scale-[0.98]">
          <span class="relative z-10 flex items-center gap-2">
            Start Practicing
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/daily" class="flex h-14 items-center justify-center rounded-full border border-hairline bg-canvas/50 backdrop-blur-sm px-10 text-base font-bold text-ink transition-all hover:bg-canvas-soft hover:border-hairline-strong active:scale-[0.98]">
          View Daily Riddle
        </a>
      </div>

      <!-- Trust/Social Proof -->
      <div class="mt-24 animate-in fade-in duration-1000 delay-500">
        <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-mute">Used by engineers at</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-8 opacity-40 grayscale contrast-125">
           <span class="text-xl font-bold tracking-tighter">Google</span>
           <span class="text-xl font-bold tracking-tighter">Meta</span>
           <span class="text-xl font-bold tracking-tighter">Amazon</span>
           <span class="text-xl font-bold tracking-tighter">Netflix</span>
           <span class="text-xl font-bold tracking-tighter">Airbnb</span>
        </div>
      </div>
    </div>
  </div>
</section>
