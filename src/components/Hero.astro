<section class="relative overflow-hidden bg-canvas py-24 sm:py-32">
  <div class="mesh-gradient absolute inset-0 opacity-20 blur-3xl"></div>
  
  <div class="relative mx-auto max-w-[1400px] px-6 text-center">
    <div class="mx-auto flex max-w-fit items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-xs font-medium text-body">
