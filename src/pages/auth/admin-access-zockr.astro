---
import Layout from "../../layouts/Layout.astro";
import { prisma } from "../../lib/db";

const { supabase, user } = Astro.locals;

if (user) {
  try {
    const dbUser = await prisma.user.findUnique({
      where: { id: user.id },
      select: { role: true },
    });
    if (dbUser?.role === "ADMIN") {
      return Astro.redirect("/admin");
    }
  } catch (err: any) {
    console.error(
      "[Admin Access Page] Database error during pre-auth:",
      err.message,
    );
  }
}

let errorMsg = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString();
  const password = formData.get("password")?.toString();

  if (email && password) {
    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorMsg = error.message;
    } else if (data.user) {
      try {
        const dbUser = await prisma.user.findUnique({
          where: { id: data.user.id },
          select: { role: true },
        });

        if (dbUser?.role === "ADMIN") {
          return Astro.redirect("/admin");
        } else {
          errorMsg =
            "Unauthorized access. This portal is restricted to system administrators.";
          await supabase.auth.signOut();
        }
      } catch (err: any) {
        console.error(
          "[Admin Access Page] Database error during post-auth:",
          err.message,
        );
        errorMsg = "System authorization check failed. Please contact support.";
        await supabase.auth.signOut();
      }
    }
  }
}
---

<Layout title="Admin Portal | RiddlesMaster" hideNavbar={true}>
  <main
    class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#0a0a0a] p-6 selection:bg-white selection:text-black"
  >
    <div
      class="w-full max-w-[440px] animate-in fade-in zoom-in-95 duration-1000"
    >
      <div
        class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111] p-8 shadow-2xl shadow-black/50"
      >
        <!-- Decorative background glow -->
        <div
          class="absolute -top-24 -left-24 h-48 w-48 rounded-full bg-white/5 blur-3xl"
        >
        </div>

        <div class="relative z-10">
          <div class="mb-8 flex flex-col items-center text-center">
            <div
              class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl border border-white/20 bg-white/5 shadow-inner"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="drop-shadow-sm"
                ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
              >
            </div>
            <h1 class="text-2xl font-bold tracking-[-0.04em] text-white">
              System Administration
            </h1>
            <p class="mt-2 text-[14px] leading-relaxed text-white/50">
              Enter your credentials to access the administrative terminal.
            </p>
          </div>

          <form method="POST" class="space-y-5">
            <div class="space-y-2">
              <label
                for="email"
                class="text-[11px] font-bold uppercase tracking-[0.15em] text-white/40"
                >Email Address</label
              >
              <input
                id="email"
                name="email"
                type="email"
                required
                class="block w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-[15px] text-white placeholder-white/20 outline-none transition-all focus:border-white/30 focus:bg-white/[0.05]"
                placeholder="admin@riddlesmaster.com"
              />
            </div>
            <div class="space-y-2">
              <label
                for="password"
                class="text-[11px] font-bold uppercase tracking-[0.15em] text-white/40"
                >Access Key</label
              >
              <input
                id="password"
                name="password"
                type="password"
                required
                class="block w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-[15px] text-white placeholder-white/20 outline-none transition-all focus:border-white/30 focus:bg-white/[0.05]"
                placeholder="••••••••"
              />
            </div>

            {
              errorMsg && (
                <div class="rounded-lg border border-red-500/20 bg-red-500/5 p-3 text-[13px] font-medium text-red-400 animate-in fade-in slide-in-from-top-2 duration-300">
                  {errorMsg}
                </div>
              )
            }

            <button
              type="submit"
              class="group relative mt-2 w-full overflow-hidden rounded-lg bg-white px-4 py-3 text-[15px] font-bold text-black transition-all hover:bg-neutral-200 active:scale-[0.98]"
            >
              <span
                class="relative z-10 flex items-center justify-center gap-2"
              >
                Authorize Access
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="transition-transform group-hover:translate-x-0.5"
                  ><path d="m9 18 6-6-6-6"></path></svg
                >
              </span>
            </button>
          </form>

          <div class="mt-8 flex items-center justify-center gap-2">
            <div class="h-1 w-1 rounded-full bg-white/20"></div>
            <p
              class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/20"
            >
              Secure Encryption Active
            </p>
            <div class="h-1 w-1 rounded-full bg-white/20"></div>
          </div>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-white/30">
        Unauthorized access is strictly prohibited and logged.
      </p>
    </div>
  </main>
</Layout>
