---
import Layout from '../layouts/Layout.astro';
import HomePage from '../app/page';
import { getTodaysProblem } from '../lib/daily';
import { getUser } from '../lib/auth/getUser';
import { prisma } from '../lib/db';
import { getStreakCount } from '../lib/auth/streak';

// Fetch the user session to check streak count
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;

let streakCount = null;
if (user) {
  // Disable caching for logged-in users to display live streak information
  Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, must-revalidate');
  streakCount = await getStreakCount(user.id);
} else {
  // Cache the page for 1 hour for guests and search engine bots
  Astro.response.headers.set('Cache-Control', 'public, max-age=3600, must-revalidate');
}

// Fetch stats & daily problem server-side
const [problem, totalProblemsCount, totalUsersCount, totalCompanyTagsCount] = await Promise.all([
  getTodaysProblem(),
  prisma.problem.count(),
  prisma.user.count(),
  prisma.tag.count({ where: { type: 'COMPANY' } })
]);
---

<Layout 
  title="Riddles Master" 
  description="Master technical prep with Riddles Master. Solve daily brain teasers, hard logic puzzles, math riddles, and interview riddles from Google, Amazon, and Microsoft with answers."
>
  <HomePage
    todaysProblem={problem}
    streakCount={streakCount}
    totalProblemsCount={totalProblemsCount}
    totalUsersCount={totalUsersCount}
    totalCompanyTagsCount={totalCompanyTagsCount}
  />
</Layout>
