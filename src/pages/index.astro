---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeaturedProblems from '../components/FeaturedProblems.astro';
import Pricing from '../components/Pricing.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		
		<!-- Daily Streak Callout -->
		<section class="border-y border-hairline bg-canvas-soft-2 py-12">
			<div class="mx-auto max-w-[1400px] px-6">
				<div class="flex flex-col items-center justify-between gap-8 rounded-2xl bg-primary p-8 text-on-primary md:flex-row md:p-12">
					<div class="max-w-xl text-center md:text-left">
						<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Don't break your streak.</h2>
						<p class="mt-4 text-on-primary/80">
							Join 5,000+ developers solving daily riddles. Track your progress with our GitHub-style activity graph.
						</p>
					</div>
					<div class="flex shrink-0 gap-4">
						<a href="/daily" class="rounded-full bg-canvas px-8 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-90">
							Solve Today's Riddle
						</a>
					</div>
				</div>
			</div>
		</section>

		<FeaturedProblems />

		<!-- Features Grid -->
		<section class="border-t border-hairline bg-canvas py-24 sm:py-32">
			<div class="mx-auto max-w-[1400px] px-6">
				<div class="mb-16">
					<h2 class="text-3xl font-bold tracking-tight">Built for engineers.</h2>
					<p class="mt-4 text-lg text-body">Every feature is designed to sharpen your technical intuition.</p>
				</div>
				<div class="grid grid-cols-1 gap-12 sm:grid-cols-3">
					<div class="flex flex-col gap-4">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-link-bg-soft text-link">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold">Technical Focus</h3>
						<p class="text-body">Specifically targeting puzzles that test logical reasoning and lateral thinking, common in modern engineering interviews.</p>
					</div>
					<div class="flex flex-col gap-4">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-soft text-violet-deep">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581a2.25 2.25 0 0 0 3.182 0l4.318-4.318a2.25 2.25 0 0 0 0-3.182L11.159 3.659A2.25 2.25 0 0 0 9.568 3Z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold">Company Tagging</h3>
						<p class="text-body">Know exactly where each riddle came from. Filters for Google, Amazon, Microsoft, and more.</p>
					</div>
					<div class="flex flex-col gap-4">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-soft text-cyan-deep">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold">Daily Streaks</h3>
						<p class="text-body">Build a habit with our daily streak system. Track your progress with a GitHub-style activity graph.</p>
					</div>
				</div>
			</div>
		</section>

		<Pricing />
		
		<!-- Final CTA -->
		<section class="bg-canvas py-24 sm:py-32">
			<div class="mx-auto max-w-[1400px] px-6 text-center">
				<h2 class="text-4xl font-bold tracking-tight">Ready to sharpen your mind?</h2>
				<p class="mt-6 text-lg text-body">Join the community of developers mastering technical lateral thinking.</p>
				<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
					<a href="/signup" class="bg-primary text-on-primary rounded-full px-10 py-4 text-lg font-semibold transition-opacity hover:opacity-90">
						Get Started for Free
					</a>
				</div>
			</div>
		</section>
	</main>
	
	<footer class="border-t border-hairline bg-canvas py-16">
		<div class="mx-auto max-w-[1400px] px-6">
			<div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
				<div class="col-span-2 lg:col-span-2">
					<a href="/" class="text-xl font-bold tracking-tighter text-ink">RiddlesMaster</a>
					<p class="mt-4 max-w-xs text-sm text-body">
						Master the technical interview with curated riddles, logic puzzles, and brain teasers.
					</p>
				</div>
				<div>
					<h4 class="text-xs font-mono font-semibold uppercase tracking-widest text-mute">Platform</h4>
					<ul class="mt-4 space-y-2">
						<li><a href="/problems" class="text-sm text-body hover:text-ink">Problems</a></li>
						<li><a href="/daily" class="text-sm text-body hover:text-ink">Daily Riddle</a></li>
						<li><a href="/pricing" class="text-sm text-body hover:text-ink">Pricing</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-mono font-semibold uppercase tracking-widest text-mute">Resources</h4>
					<ul class="mt-4 space-y-2">
						<li><a href="#" class="text-sm text-body hover:text-ink">Documentation</a></li>
						<li><a href="#" class="text-sm text-body hover:text-ink">Help Center</a></li>
						<li><a href="#" class="text-sm text-body hover:text-ink">Community</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-mono font-semibold uppercase tracking-widest text-mute">Company</h4>
					<ul class="mt-4 space-y-2">
						<li><a href="#" class="text-sm text-body hover:text-ink">About</a></li>
						<li><a href="#" class="text-sm text-body hover:text-ink">Privacy</a></li>
						<li><a href="#" class="text-sm text-body hover:text-ink">Terms</a></li>
					</ul>
				</div>
			</div>
			<div class="mt-16 border-t border-hairline pt-8 flex flex-col items-center justify-between gap-6 sm:flex-row">
				<p class="text-xs text-mute">© 2026 RiddlesMaster. All rights reserved.</p>
				<div class="flex gap-6">
					<a href="#" class="text-mute hover:text-ink">
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
					</a>
					<a href="#" class="text-mute hover:text-ink">
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm6.066 9.645c.183 4.04-2.83 8.544-8.164 8.544-1.623 0-3.108-.47-4.354-1.285.23.028.46.04.697.04 1.335 0 2.59-.454 3.597-1.217-1.248-.025-2.3-.847-2.666-1.984.17.027.35.04.538.04.255 0 .52-.035.77-.103-1.311-.27-2.3-1.405-2.3-2.774v-.037c.39.218.83.35 1.3.363-.77-.515-1.273-1.398-1.273-2.394 0-.53.144-1.018.39-1.438 1.411 1.735 3.518 2.874 5.895 2.997-.048-.21-.072-.43-.072-.653 0-1.582 1.29-2.864 2.884-2.864.828 0 1.574.348 2.1 0 .657-.128 1.27-.36 1.823-.69-.215.67-.67 1.233-1.27 1.591.583-.07 1.135-.224 1.656-.453-.387.578-.87 1.084-1.43 1.489z"/></svg>
					</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>
