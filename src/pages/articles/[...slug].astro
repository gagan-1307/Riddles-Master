---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

// Enable hybrid caching: 5 min max-age, 10 min stale-while-revalidate, vary by user session cookie
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
Astro.response.headers.set('Vary', 'Cookie');

const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find((p) => p.id === slug);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

// Reading time estimate
const getReadingTime = (text: string) => {
  const wordsPerMinute = 200;
  const numberOfWords = text ? text.split(/\s+/g).length : 0;
  return Math.ceil(numberOfWords / wordsPerMinute);
};

const readingTime = getReadingTime(post.body || '');

// Date formatting
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// SEO OG Image
const ogImage = post.data.coverImage 
  ? new URL(post.data.coverImage.src, Astro.url.origin).toString()
  : undefined;
---

<Layout 
  title={`${post.data.title} | RiddlesMaster`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
>
  <main class="mx-auto max-w-[800px] px-6 py-12">
    <!-- Back to Articles -->
    <nav class="mb-8">
      <a 
        href="/articles" 
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#6c6a64] hover:text-[#cc785c] transition-colors decoration-none"
      >
        <span>←</span> Back to Articles
      </a>
    </nav>

    <!-- Article Header -->
    <header class="mb-8">
      <!-- Date & Reading Time -->
      <div class="flex items-center gap-3 text-xs text-[#8e8b82] uppercase tracking-wider font-semibold font-sans mb-3">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span class="text-[#e6dfd8]">•</span>
        <span>{readingTime} min read</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight font-serif text-[#141413] leading-tight">
        {post.data.title}
      </h1>

      <!-- Description -->
      <p class="mt-4 text-[#3d3d3a] font-sans text-base leading-relaxed italic">
        {post.data.description}
      </p>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-6">
          {post.data.tags.map((tag) => (
            <span class="text-[10px] bg-[#efe9de] text-[#141413] px-2.5 py-1 rounded-[4px] font-semibold font-sans">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Cover Image -->
    {post.data.coverImage && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-[#e6dfd8] aspect-[16/9]">
        <Image 
          src={post.data.coverImage} 
          alt={post.data.title}
          width={800}
          height={450}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Article Markdown Content -->
    <article class="prose prose-stone max-w-none font-sans text-sm text-[#3d3d3a] leading-relaxed space-y-6">
      <Content />
    </article>
  </main>
</Layout>
