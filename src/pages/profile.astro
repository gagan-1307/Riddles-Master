---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getUser } from "../lib/auth/getUser";
import { prisma } from "../lib/db";
import { getStreakCount, getMaxStreakCount } from "../lib/auth/streak";
import { checkPremium } from "../lib/auth/checkPremium";
import {
  Flame,
  Award,
  Shield,
  Crown,
  ArrowRight,
} from "lucide-react";
import { formatPrice } from "../lib/currency";

// Authenticate user
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;

if (!user) {
  return Astro.redirect("/login");
}

// Fetch streak counts
const currentStreak = await getStreakCount(user.id);
const maxStreak = await getMaxStreakCount(user.id);

// Check premium status
const isPremium = await checkPremium(user.id);

// Query solved problems for the user
const solvedStatuses = await prisma.userProblemStatus.findMany({
  where: {
    userId: user.id,
    solved: true,
  },
  include: {
    problem: {
      select: {
        difficulty: true,
      },
    },
  },
});

// Count solved by difficulty
const solvedCount = {
  EASY: solvedStatuses.filter((s) => s.problem.difficulty === "EASY").length,
  MEDIUM: solvedStatuses.filter((s) => s.problem.difficulty === "MEDIUM")
    .length,
  HARD: solvedStatuses.filter((s) => s.problem.difficulty === "HARD").length,
  TOTAL: solvedStatuses.length,
};

// Count total problems in DB by difficulty
const allProblems = await prisma.problem.findMany({
  select: {
    difficulty: true,
  },
});

const totalCount = {
  EASY: allProblems.filter((p) => p.difficulty === "EASY").length,
  MEDIUM: allProblems.filter((p) => p.difficulty === "MEDIUM").length,
  HARD: allProblems.filter((p) => p.difficulty === "HARD").length,
  TOTAL: allProblems.length,
};

// Calculate percentages safely (avoid dividing by zero)
const getPercentage = (solved: number, total: number) => {
  if (total === 0) return 0;
  return Math.round((solved / total) * 100);
};

const easyPct = getPercentage(solvedCount.EASY, totalCount.EASY);
const mediumPct = getPercentage(solvedCount.MEDIUM, totalCount.MEDIUM);
const hardPct = getPercentage(solvedCount.HARD, totalCount.HARD);
const totalPct = getPercentage(solvedCount.TOTAL, totalCount.TOTAL);

const userDisplayName =
  (user as any).name ||
  (user as any).user_metadata?.full_name ||
  (user as any).user_metadata?.name ||
  user.email?.split("@")[0];
const userAvatarUrl =
  (user as any).avatarUrl ||
  (user as any).user_metadata?.avatar_url ||
  (user as any).user_metadata?.avatarUrl;
const userAvatarLetter = user.email ? user.email[0].toUpperCase() : "U";

// 1. Query Liked Problems
const likedProblems = await prisma.likedProblem.findMany({
  where: { userId: user.id },
  include: {
    problem: {
      select: {
        id: true,
        title: true,
        slug: true,
        difficulty: true
      }
    }
  },
  orderBy: { createdAt: 'desc' }
});

// 2. Query Solved Problems detail list
const solvedList = await prisma.userProblemStatus.findMany({
  where: { userId: user.id, solved: true },
  include: {
    problem: {
      select: {
        id: true,
        title: true,
        slug: true,
        difficulty: true
      }
    }
  },
  orderBy: { solvedAt: 'desc' }
});

// 3. Aggregate practice stats for the profile page
const attempts = await prisma.practiceAttempt.findMany({
  where: { userId: user.id },
  include: {
    set: {
      include: {
        topic: true
      }
    }
  }
});

const allTopics = await prisma.practiceTopic.findMany({
  include: {
    sets: { select: { id: true } }
  }
});

// Group attempts by topic
const topicGroups: Record<string, {
  topicId: string;
  topicName: string;
  topicSlug: string;
  topicIcon: string | null;
  groupName: string;
  score: number;
  totalAttempted: number;
  setIds: Set<string>;
}> = {};

attempts.forEach(a => {
  const topic = a.set?.topic;
  if (!topic) return;

  if (!topicGroups[topic.id]) {
    topicGroups[topic.id] = {
      topicId: topic.id,
      topicName: topic.name,
      topicSlug: topic.slug,
      topicIcon: topic.icon,
      groupName: topic.group,
      score: 0,
      totalAttempted: 0,
      setIds: new Set<string>()
    };
  }
  topicGroups[topic.id].score += a.score;
  topicGroups[topic.id].totalAttempted += a.totalAttempted;
  topicGroups[topic.id].setIds.add(a.setId);
});

const topicBreakdown = Object.values(topicGroups).map(t => {
  const topicAccuracy = t.totalAttempted > 0 
    ? Math.round((t.score / t.totalAttempted) * 100) 
    : 0;
  return {
    topicId: t.topicId,
    name: t.topicName,
    slug: t.topicSlug,
    icon: t.topicIcon,
    group: t.groupName,
    accuracy: topicAccuracy,
    setsAttempted: t.setIds.size,
    questionsAttempted: t.totalAttempted
  };
});

const weakTopics = topicBreakdown.filter(t => t.accuracy < 60);
const strongTopics = topicBreakdown.filter(t => t.accuracy > 80);

const topicAccuracyMap = new Map<string, number>();
topicBreakdown.forEach(t => {
  topicAccuracyMap.set(t.topicId, t.accuracy);
});

// Sort for recommendation
const allTopicsForRec = [...allTopics];
allTopicsForRec.sort((a, b) => {
  const accA = topicAccuracyMap.has(a.id) ? topicAccuracyMap.get(a.id)! : 0;
  const accB = topicAccuracyMap.has(b.id) ? topicAccuracyMap.get(b.id)! : 0;
  if (accA !== accB) {
    return accA - accB; // lowest user accuracy first
  }
  return b.sets.length - a.sets.length; // most sets available first
});

const recTopic = allTopicsForRec[0] || null;
const recommended = recTopic ? {
  id: recTopic.id,
  name: recTopic.name,
  slug: recTopic.slug,
  icon: recTopic.icon,
  accuracy: topicAccuracyMap.has(recTopic.id) ? topicAccuracyMap.get(recTopic.id)! : 0
} : null;

// Group breakdown table
const groupAggregates: Record<string, {
  groupName: string;
  topicsPracticed: Set<string>;
  score: number;
  totalAttempted: number;
}> = {};

attempts.forEach(a => {
  const topic = a.set?.topic;
  if (!topic) return;

  if (!groupAggregates[topic.group]) {
    groupAggregates[topic.group] = {
      groupName: topic.group,
      topicsPracticed: new Set<string>(),
      score: 0,
      totalAttempted: 0
    };
  }
  groupAggregates[topic.group].topicsPracticed.add(topic.id);
  groupAggregates[topic.group].score += a.score;
  groupAggregates[topic.group].totalAttempted += a.totalAttempted;
});

const groupBreakdown = Object.values(groupAggregates).map(g => ({
  group: g.groupName,
  topicsPracticed: g.topicsPracticed.size,
  avgAccuracy: g.totalAttempted > 0 ? Math.round((g.score / g.totalAttempted) * 100) : 0,
  questionsDone: g.totalAttempted
}));

// Overall totals
let totalQuestionsAttempted = 0;
let totalCorrect = 0;
let testAttempts = 0;
let practiceAttempts = 0;
const testSetIds = new Set<string>();

attempts.forEach(a => {
  totalQuestionsAttempted += a.totalAttempted;
  totalCorrect += a.score;
  if (a.mode === 'TEST') {
    testAttempts++;
    testSetIds.add(a.setId);
  } else {
    practiceAttempts++;
  }
});

const overallAccuracy = totalQuestionsAttempted > 0 
  ? Math.round((totalCorrect / totalQuestionsAttempted) * 100) 
  : 0;

const setsCompleted = testSetIds.size;

const formatGroup = (group: string) => {
  switch (group) {
    case 'APTITUDE': return 'Aptitude';
    case 'LOGICAL_REASONING': return 'Logical';
    case 'VERBAL_REASONING': return 'Verbal';
    case 'NONVERBAL_REASONING': return 'Non-Verbal';
    default: return group;
  }
};
---

<Layout title="Your Profile | RiddlesMaster">
  <main class="mx-auto max-w-[1100px] px-6 py-12">
    <!-- Header Section -->
    <div class="mb-10 border-b border-[#e6dfd8] pb-6">
      <span
        class="text-xs font-semibold uppercase tracking-widest text-[#cc785c]"
      >
        Dashboard
      </span>
      <h1 class="text-4xl font-bold font-serif text-[#141413] mt-1">
        Your Profile
      </h1>
      <p class="text-[15px] text-[#6c6a64] mt-1.5 font-medium">
        Track your statistics, milestones, and master your technical interview
        prep.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: User Card & Membership status -->
      <div class="space-y-6 lg:col-span-1">
        <!-- Account Info Card -->
        <div
          class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm flex flex-col items-center text-center"
        >
          <div
            class="h-20 w-20 rounded-full bg-[#cc785c]/10 border border-[#cc785c]/20 flex items-center justify-center text-[#cc785c] mb-4 text-2xl font-bold font-serif shadow-inner"
          >
            {
              userAvatarUrl ? (
                <Image
                  src={userAvatarUrl}
                  alt="Avatar"
                  width={80}
                  height={80}
                  class="h-full w-full rounded-full object-cover"
                />
              ) : (
                <span>{userAvatarLetter}</span>
              )
            }
          </div>
          <h2 class="text-xl font-bold text-[#141413] font-serif capitalize">
            {userDisplayName}
          </h2>
          <p class="text-sm text-[#6c6a64] mt-1">{user.email}</p>

          <div
            class="w-full border-t border-[#e6dfd8] mt-6 pt-6 text-left space-y-3"
          >
            <div>
              <span
                class="text-[10px] font-bold uppercase tracking-wider text-[#8e8b82]"
                >User ID</span
              >
              <p class="text-xs font-mono text-[#6c6a64] truncate mt-0.5">
                {user.id}
              </p>
            </div>
          </div>
        </div>

        <!-- Membership / Subscription Card -->
        <div
          class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm"
        >
          <h3
            class="text-xs font-bold uppercase tracking-wider text-[#8e8b82] mb-4"
          >
            Membership Plan
          </h3>
          {
            isPremium ? (
              <div class="space-y-4">
                <div class="flex items-center gap-3 bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-[#f5d996] rounded-md p-4">
                  <Crown className="h-8 w-8 text-amber-600 fill-amber-500/20" />
                  <div>
                    <h4 class="font-bold text-amber-800 text-[15px] font-serif">
                      RiddlesMaster Premium
                    </h4>
                    <p class="text-[11px] font-semibold text-amber-600 uppercase tracking-wider mt-0.5">
                      Active Member
                    </p>
                  </div>
                </div>
                <p class="text-xs text-[#6c6a64] leading-relaxed">
                  You have unlimited access to all premium riddles, company
                  filters, and step-by-step editorial explanations.
                </p>
                {dbUser?.subscription && (
                  <p class="text-xs text-[#6c6a64] font-medium mt-1">
                    You paid{" "}
                    {formatPrice(
                      dbUser.subscription.amountPaid,
                      dbUser.subscription.currency,
                    )}{" "}
                    ({dbUser.subscription.currency})
                  </p>
                )}
              </div>
            ) : (
              <div class="space-y-4">
                <div class="flex items-center gap-3 bg-[#f5f0e8]/50 border border-[#e6dfd8] rounded-md p-4">
                  <Shield className="h-8 w-8 text-[#6c6a64]" />
                  <div>
                    <h4 class="font-bold text-[#141413] text-[15px] font-serif">
                      Free Plan
                    </h4>
                    <p class="text-[11px] font-semibold text-[#6c6a64] uppercase tracking-wider mt-0.5">
                      Standard Access
                    </p>
                  </div>
                </div>
                <p class="text-xs text-[#6c6a64] leading-relaxed">
                  Upgrade to Premium to unlock full company-specific sets and
                  detailed step-by-step analytical solutions.
                </p>
                <a
                  href="/pricing"
                  class="inline-flex w-full h-9 items-center justify-center rounded-md bg-[#cc785c] text-xs font-semibold text-white transition-all hover:bg-[#a9583e] active:scale-[0.98] shadow-sm gap-1.5"
                >
                  <span>Upgrade to Premium</span>
                  <ArrowRight className="h-3.5 w-3.5" />
                </a>
              </div>
            )
          }
        </div>
      </div>

      <!-- Right Column: Stats & Performance -->
      <div class="space-y-6 lg:col-span-2">
        <!-- Streak Milestone Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Current Streak Card -->
          <div
            class="rounded-lg border border-[#f5d996] bg-[#fdf6e2] p-5 shadow-sm flex items-center gap-4"
          >
            <div
              class="h-12 w-12 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-600"
            >
              <Flame className="h-6 w-6 fill-orange-500/20" />
            </div>
            <div>
              <span
                class="text-xs font-bold text-[#b25e00] uppercase tracking-wider block"
                >Current Streak</span
              >
              <span
                class="text-2xl font-bold font-serif text-[#181715] mt-0.5 block"
              >
                {currentStreak}
                {currentStreak === 1 ? "day" : "days"}
              </span>
            </div>
          </div>

          <!-- Max Streak Card -->
          <div
            class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-5 shadow-sm flex items-center gap-4"
          >
            <div
              class="h-12 w-12 rounded-full bg-[#cc785c]/10 border border-[#cc785c]/20 flex items-center justify-center text-[#cc785c]"
            >
              <Award className="h-6 w-6 fill-[#cc785c]/15" />
            </div>
            <div>
              <span
                class="text-xs font-bold text-[#6c6a64] uppercase tracking-wider block"
                >Max Streak</span
              >
              <span
                class="text-2xl font-bold font-serif text-[#181715] mt-0.5 block"
              >
                {maxStreak}
                {maxStreak === 1 ? "day" : "days"}
              </span>
            </div>
          </div>
        </div>

        <!-- TABS TRIGGER BAR -->
        <div class="flex border-b border-[#e6dfd8] mb-6 gap-6 font-sans select-none">
          <button 
            type="button"
            class="tab-btn pb-2.5 text-[13px] font-bold tracking-wider uppercase border-b-2 transition-all duration-150 cursor-pointer border-transparent text-[#8e8b82] hover:text-[#141413]" 
            data-tab="solved"
          >
            Solved
          </button>
          <button 
            type="button"
            class="tab-btn pb-2.5 text-[13px] font-bold tracking-wider uppercase border-b-2 transition-all duration-150 cursor-pointer border-transparent text-[#8e8b82] hover:text-[#141413]" 
            data-tab="liked"
          >
            Liked
          </button>
          <button 
            type="button"
            class="tab-btn pb-2.5 text-[13px] font-bold tracking-wider uppercase border-b-2 transition-all duration-150 cursor-pointer border-transparent text-[#8e8b82] hover:text-[#141413]" 
            data-tab="practice"
          >
            Practice
          </button>
        </div>

        <!-- SOLVED TAB CONTENT -->
        <div id="tab-content-solved" class="tab-panel hidden space-y-6">
          <!-- Problem Solving Progress Card -->
          <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 shadow-sm">
            <div class="flex items-center justify-between border-b border-[#e6dfd8] pb-4 mb-6">
              <h3 class="text-lg font-bold font-serif text-[#141413]">
                Problem Solving Progress
              </h3>
              <span class="text-sm font-mono text-[#6c6a64] font-medium">
                Solved {solvedCount.TOTAL} / {totalCount.TOTAL}
              </span>
            </div>

            <!-- Overall Progress Bar -->
            <div class="mb-8">
              <div class="flex justify-between text-xs font-bold uppercase tracking-wider text-[#6c6a64] mb-1.5">
                <span>Overall Completion</span>
                <span>{totalPct}%</span>
              </div>
              <div class="w-full h-3 bg-[#efe9de] rounded-full overflow-hidden border border-[#e6dfd8]/50">
                <div
                  class="h-full bg-gradient-to-r from-amber-500 to-[#cc785c] rounded-full transition-all duration-500"
                  style={`width: ${totalPct}%`}
                >
                </div>
              </div>
            </div>

            <!-- Difficulty Progress Bars -->
            <div class="space-y-5">
              <!-- Easy Progress -->
              <div>
                <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                  <span class="flex items-center gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-[#5db872]"></span>
                    <span class="font-bold text-[#2e7d32] uppercase tracking-wider text-[11px]">Easy Problems</span>
                  </span>
                  <span class="font-mono text-[#6c6a64]">
                    {solvedCount.EASY} / {totalCount.EASY}
                    <span class="text-xs text-[#8e8b82] ml-1">({easyPct}%)</span>
                  </span>
                </div>
                <div class="w-full h-2 bg-[#5db872]/10 rounded-full overflow-hidden border border-[#5db872]/20">
                  <div
                    class="h-full bg-[#5db872] rounded-full transition-all duration-500"
                    style={`width: ${easyPct}%`}
                  >
                  </div>
                </div>
              </div>

              <!-- Medium Progress -->
              <div>
                <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                  <span class="flex items-center gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-[#e8a55a]"></span>
                    <span class="font-bold text-[#b26a00] uppercase tracking-wider text-[11px]">Medium Problems</span>
                  </span>
                  <span class="font-mono text-[#6c6a64]">
                    {solvedCount.MEDIUM} / {totalCount.MEDIUM}
                    <span class="text-xs text-[#8e8b82] ml-1">({mediumPct}%)</span>
                  </span>
                </div>
                <div class="w-full h-2 bg-[#e8a55a]/10 rounded-full overflow-hidden border border-[#e8a55a]/20">
                  <div
                    class="h-full bg-[#e8a55a] rounded-full transition-all duration-500"
                    style={`width: ${mediumPct}%`}
                  >
                  </div>
                </div>
              </div>

              <!-- Hard Progress -->
              <div>
                <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                  <span class="flex items-center gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-[#c64545]"></span>
                    <span class="font-bold text-[#c64545] uppercase tracking-wider text-[11px]">Hard Problems</span>
                  </span>
                  <span class="font-mono text-[#6c6a64]">
                    {solvedCount.HARD} / {totalCount.HARD}
                    <span class="text-xs text-[#8e8b82] ml-1">({hardPct}%)</span>
                  </span>
                </div>
                <div class="w-full h-2 bg-[#c64545]/10 rounded-full overflow-hidden border border-[#c64545]/20">
                  <div
                    class="h-full bg-[#c64545] rounded-full transition-all duration-500"
                    style={`width: ${hardPct}%`}
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Solved List Details -->
          <div class="rounded-lg border border-[#e6dfd8] bg-white p-6 shadow-sm">
            <h3 class="text-base font-bold font-serif text-[#141413] mb-4">Solved Riddles List</h3>
            {solvedList.length === 0 ? (
              <p class="text-xs text-[#6c6a64] italic font-sans">You haven't solved any riddles yet.</p>
            ) : (
              <div class="overflow-x-auto">
                <table class="w-full text-sm font-sans text-[#141413]">
                  <thead>
                    <tr class="border-b border-[#e6dfd8] text-[10px] font-bold tracking-wider text-[#8e8b82] uppercase text-left">
                      <th class="pb-2">Title</th>
                      <th class="pb-2 text-right">Difficulty</th>
                    </tr>
                  </thead>
                  <tbody>
                    {solvedList.map(s => (
                      <tr class="border-b border-[#e6dfd8] last:border-0 hover:bg-[#faf9f5]/50 transition-colors">
                        <td class="py-2.5">
                          <a href={`/problems/${s.problem.slug}`} class="text-[#cc785c] font-medium hover:underline decoration-none">
                            {s.problem.title}
                          </a>
                        </td>
                        <td class="py-2.5 text-right">
                          <span class={`text-[10px] font-bold uppercase tracking-wider ${
                            s.problem.difficulty === 'EASY' ? 'text-[#5db872]' : s.problem.difficulty === 'MEDIUM' ? 'text-[#e8a55a]' : 'text-[#c64545]'
                          }`}>
                            {s.problem.difficulty}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </div>

        <!-- LIKED TAB CONTENT -->
        <div id="tab-content-liked" class="tab-panel hidden space-y-6">
          <div class="rounded-lg border border-[#e6dfd8] bg-white p-6 shadow-sm">
            <h3 class="text-base font-bold font-serif text-[#141413] mb-4">Liked Riddles</h3>
            {likedProblems.length === 0 ? (
              <p class="text-xs text-[#6c6a64] italic font-sans">No liked riddles yet.</p>
            ) : (
              <div class="overflow-x-auto">
                <table class="w-full text-sm font-sans text-[#141413]">
                  <thead>
                    <tr class="border-b border-[#e6dfd8] text-[10px] font-bold tracking-wider text-[#8e8b82] uppercase text-left">
                      <th class="pb-2">Title</th>
                      <th class="pb-2 text-right">Difficulty</th>
                    </tr>
                  </thead>
                  <tbody>
                    {likedProblems.map(l => (
                      <tr class="border-b border-[#e6dfd8] last:border-0 hover:bg-[#faf9f5]/50 transition-colors">
                        <td class="py-2.5">
                          <a href={`/problems/${l.problem.slug}`} class="text-[#cc785c] font-medium hover:underline decoration-none">
                            {l.problem.title}
                          </a>
                        </td>
                        <td class="py-2.5 text-right">
                          <span class={`text-[10px] font-bold uppercase tracking-wider ${
                            l.problem.difficulty === 'EASY' ? 'text-[#5db872]' : l.problem.difficulty === 'MEDIUM' ? 'text-[#e8a55a]' : 'text-[#c64545]'
                          }`}>
                            {l.problem.difficulty}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </div>

        <!-- PRACTICE TAB CONTENT -->
        <div id="tab-content-practice" class="tab-panel hidden space-y-6">
          <!-- Overall stats row (4 cards) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-white border border-[#e6dfd8] rounded-xl p-4 shadow-sm text-center">
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-1 font-sans">Total Questions</div>
              <div class="text-xl font-bold text-[#141413] font-mono">{totalQuestionsAttempted}</div>
            </div>
            <div class="bg-white border border-[#e6dfd8] rounded-xl p-4 shadow-sm text-center">
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-1 font-sans">Overall Accuracy</div>
              <div class="text-xl font-bold text-[#cc785c] font-mono">{overallAccuracy}%</div>
            </div>
            <div class="bg-white border border-[#e6dfd8] rounded-xl p-4 shadow-sm text-center">
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-1 font-sans">Sets Completed</div>
              <div class="text-xl font-bold text-[#141413] font-mono">{setsCompleted}</div>
            </div>
            <div class="bg-white border border-[#e6dfd8] rounded-xl p-4 shadow-sm text-center">
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-1 font-sans">Test Attempts</div>
              <div class="text-xl font-bold text-[#141413] font-mono">{testAttempts}</div>
            </div>
          </div>

          <!-- Weak and Strong Topic Badges -->
          <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm space-y-4 font-sans">
            <div>
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-2">Weak Areas (&lt; 60% accuracy)</div>
              <div class="flex flex-wrap gap-2">
                {weakTopics.length === 0 ? (
                  <span class="text-xs text-zinc-500 font-medium">—</span>
                ) : (
                  weakTopics.map(t => (
                    <a href={`/practice/${t.slug}`} class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-[#c64545] border border-red-200 hover:bg-red-100 transition-colors decoration-none">
                      {t.icon || '🔢'} {t.name} ({t.accuracy}%)
                    </a>
                  ))
                )}
              </div>
            </div>

            <hr class="border-[#e6dfd8]" />

            <div>
              <div class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider mb-2">Strong Areas (&gt; 80% accuracy)</div>
              <div class="flex flex-wrap gap-2">
                {strongTopics.length === 0 ? (
                  <span class="text-xs text-zinc-500 font-medium">—</span>
                ) : (
                  strongTopics.map(t => (
                    <a href={`/practice/${t.slug}`} class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-[#5db872] border border-green-200 hover:bg-green-100 transition-colors decoration-none">
                      {t.icon || '🔢'} {t.name} ({t.accuracy}%)
                    </a>
                  ))
                )}
              </div>
            </div>
          </div>

          {/* Group breakdown table */}
          <div class="rounded-lg border border-[#e6dfd8] bg-white p-6 shadow-sm">
            <h3 class="text-base font-bold font-serif text-[#141413] mb-4">Breakdown by Group</h3>
            {groupBreakdown.length === 0 ? (
              <p class="text-xs text-[#6c6a64] italic font-sans">No practice sessions started yet.</p>
            ) : (
              <div class="overflow-x-auto">
                <table class="w-full text-sm font-sans text-[#141413]">
                  <thead>
                    <tr class="border-b border-[#e6dfd8] text-[10px] font-bold tracking-wider text-[#8e8b82] uppercase text-left">
                      <th class="pb-2">Group</th>
                      <th class="pb-2 text-center">Topics Practiced</th>
                      <th class="pb-2 text-center">Avg Accuracy</th>
                      <th class="pb-2 text-center">Questions Done</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupBreakdown.map(g => (
                      <tr class="border-b border-[#e6dfd8] last:border-0 hover:bg-[#faf9f5]/50 transition-colors">
                        <td class="py-2.5 font-medium text-[#141413]">
                          {formatGroup(g.group)}
                        </td>
                        <td class="py-2.5 text-center text-zinc-600">
                          {g.topicsPracticed}
                        </td>
                        <td class="py-2.5 text-center">
                          <span class={`font-mono font-bold ${
                            g.avgAccuracy >= 80 ? 'text-[#16a34a]' : g.avgAccuracy >= 50 ? 'text-[#d4a017]' : 'text-[#c64545]'
                          }`}>
                            {g.avgAccuracy}%
                          </span>
                        </td>
                        <td class="py-2.5 text-center text-zinc-600">
                          {g.questionsDone}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          <!-- Recommended Next Card -->
          {recommended && (
            <div class="rounded-xl border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 font-sans">
              <div>
                <span class="text-[10px] font-bold text-[#8e8b82] uppercase tracking-wider block mb-1">Recommended Next Topic</span>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-2xl leading-none">{recommended.icon || '🔢'}</span>
                  <h4 class="text-base font-bold text-[#141413]">{recommended.name}</h4>
                </div>
                <p class="text-xs text-zinc-500 mt-1.5 font-medium">
                  Your accuracy: <span class="font-bold text-[#cc785c]">{recommended.accuracy}%</span> — needs improvement
                </p>
              </div>
              <a 
                href={`/practice/${recommended.slug}`} 
                class="inline-flex h-9 items-center justify-center rounded-[8px] bg-[#cc785c] px-5 text-xs font-semibold text-white shadow-md shadow-[#cc785c]/10 transition-all hover:bg-[#a9583e] active:scale-[0.98] cursor-pointer decoration-none"
              >
                Start Practicing →
              </a>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Script Block for Tabs Switcher -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.tab-btn');
        const panels = document.querySelectorAll('.tab-panel');

        function setActiveTab(tabName) {
          tabs.forEach(t => {
            if (t.getAttribute('data-tab') === tabName) {
              t.classList.add('border-[#cc785c]', 'text-[#141413]');
              t.classList.remove('border-transparent', 'text-[#8e8b82]');
            } else {
              t.classList.remove('border-[#cc785c]', 'text-[#141413]');
              t.classList.add('border-transparent', 'text-[#8e8b82]');
            }
          });

          panels.forEach(p => {
            if (p.id === `tab-content-${tabName}`) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          });
        }

        tabs.forEach(t => {
          t.addEventListener('click', () => {
            const tabName = t.getAttribute('data-tab');
            setActiveTab(tabName);
            localStorage.setItem('profile_active_tab', tabName);
          });
        });

        // Restore active tab or default to 'solved'
        const savedTab = localStorage.getItem('profile_active_tab') || 'solved';
        setActiveTab(savedTab);
      });
    </script>
  </main>
</Layout>
