---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getUser } from "../lib/auth/getUser";
import { prisma } from "../lib/db";
import { getStreakCount, getMaxStreakCount } from "../lib/auth/streak";
import { Flame, Award, CheckCircle2, Shield, Crown, ArrowRight, User } from "lucide-react";

// Authenticate user (includes subscription relation)
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;

if (!user) {
  return Astro.redirect("/login");
}

// Fetch streak counts
const currentStreak = await getStreakCount(user.id);
const maxStreak = await getMaxStreakCount(user.id);

// Check premium status directly from the user's fetched subscription object to avoid extra query
const isPremium = !!(
  dbUser?.subscription &&
  dbUser.subscription.status === "ACTIVE" &&
  new Date(dbUser.subscription.endDate) > new Date()
);

// Query solved problems for the user
const solvedStatuses = await prisma.userProblemStatus.findMany({
  where: {
    userId: user.id,
    solved: true,
  },
  include: {
    problem: {
      select: {
        difficulty: true,
      },
    },
  },
});

// Count solved by difficulty
const solvedCount = {
  EASY: solvedStatuses.filter(s => s.problem.difficulty === "EASY").length,
  MEDIUM: solvedStatuses.filter(s => s.problem.difficulty === "MEDIUM").length,
  HARD: solvedStatuses.filter(s => s.problem.difficulty === "HARD").length,
  TOTAL: solvedStatuses.length,
};

// Count total problems in DB by difficulty
const allProblems = await prisma.problem.findMany({
  select: {
    difficulty: true,
  },
});

const totalCount = {
  EASY: allProblems.filter(p => p.difficulty === "EASY").length,
  MEDIUM: allProblems.filter(p => p.difficulty === "MEDIUM").length,
  HARD: allProblems.filter(p => p.difficulty === "HARD").length,
  TOTAL: allProblems.length,
};

// Calculate percentages safely (avoid dividing by zero)
const getPercentage = (solved: number, total: number) => {
  if (total === 0) return 0;
  return Math.round((solved / total) * 100);
};

const easyPct = getPercentage(solvedCount.EASY, totalCount.EASY);
const mediumPct = getPercentage(solvedCount.MEDIUM, totalCount.MEDIUM);
const hardPct = getPercentage(solvedCount.HARD, totalCount.HARD);
const totalPct = getPercentage(solvedCount.TOTAL, totalCount.TOTAL);

const userDisplayName = (user as any).name || (user as any).user_metadata?.full_name || (user as any).user_metadata?.name || user.email?.split("@")[0];
const userAvatarUrl = (user as any).avatarUrl || (user as any).user_metadata?.avatar_url || (user as any).user_metadata?.avatarUrl;
const userAvatarLetter = user.email ? user.email[0].toUpperCase() : "U";
---

<Layout title="Your Profile | RiddlesMaster">
  <main class="mx-auto max-w-[1100px] px-6 py-12">
    <!-- Header Section -->
    <div class="mb-10 border-b border-[#e6dfd8] pb-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-[#cc785c]">
        Dashboard
      </span>
      <h1 class="text-4xl font-bold font-serif text-[#141413] mt-1">
        Your Profile
      </h1>
      <p class="text-[15px] text-[#6c6a64] mt-1.5 font-medium">
        Track your statistics, milestones, and master your technical interview prep.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: User Card & Membership status -->
      <div class="space-y-6 lg:col-span-1">
        <!-- Account Info Card -->
        <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm flex flex-col items-center text-center">
          <div class="h-20 w-20 rounded-full bg-[#cc785c]/10 border border-[#cc785c]/20 flex items-center justify-center text-[#cc785c] mb-4 text-2xl font-bold font-serif shadow-inner">
            {userAvatarUrl ? (
              <Image src={userAvatarUrl} alt="Avatar" width={80} height={80} class="h-full w-full rounded-full object-cover" />
            ) : (
              <span>{userAvatarLetter}</span>
            )}
          </div>
          <h2 class="text-xl font-bold text-[#141413] font-serif capitalize">
            {userDisplayName}
          </h2>
          <p class="text-sm text-[#6c6a64] mt-1">{user.email}</p>

          <div class="w-full border-t border-[#e6dfd8] mt-6 pt-6 text-left space-y-3">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#8e8b82]">User ID</span>
              <p class="text-xs font-mono text-[#6c6a64] truncate mt-0.5">{user.id}</p>
            </div>
          </div>
        </div>

        <!-- Membership / Subscription Card -->
        <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-6 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#8e8b82] mb-4">Membership Plan</h3>
          {isPremium ? (
            <div class="space-y-4">
              <div class="flex items-center gap-3 bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-[#f5d996] rounded-md p-4">
                <Crown className="h-8 w-8 text-amber-600 fill-amber-500/20" />
                <div>
                  <h4 class="font-bold text-amber-800 text-[15px] font-serif">RiddlesMaster Premium</h4>
                  <p class="text-[11px] font-semibold text-amber-600 uppercase tracking-wider mt-0.5">Active Member</p>
                </div>
              </div>
              <p class="text-xs text-[#6c6a64] leading-relaxed">
                You have unlimited access to all premium riddles, company filters, and step-by-step editorial explanations.
              </p>
            </div>
          ) : (
            <div class="space-y-4">
              <div class="flex items-center gap-3 bg-[#f5f0e8]/50 border border-[#e6dfd8] rounded-md p-4">
                <Shield className="h-8 w-8 text-[#6c6a64]" />
                <div>
                  <h4 class="font-bold text-[#141413] text-[15px] font-serif">Free Plan</h4>
                  <p class="text-[11px] font-semibold text-[#6c6a64] uppercase tracking-wider mt-0.5">Standard Access</p>
                </div>
              </div>
              <p class="text-xs text-[#6c6a64] leading-relaxed">
                Upgrade to Premium to unlock full company-specific sets and detailed step-by-step analytical solutions.
              </p>
              <a
                href="/pricing"
                class="inline-flex w-full h-9 items-center justify-center rounded-md bg-[#cc785c] text-xs font-semibold text-white transition-all hover:bg-[#a9583e] active:scale-[0.98] shadow-sm gap-1.5"
              >
                <span>Upgrade to Premium</span>
                <ArrowRight className="h-3.5 w-3.5" />
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Stats & Performance -->
      <div class="space-y-6 lg:col-span-2">
        <!-- Streak Milestone Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Current Streak Card -->
          <div class="rounded-lg border border-[#f5d996] bg-[#fdf6e2] p-5 shadow-sm flex items-center gap-4">
            <div class="h-12 w-12 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-600">
              <Flame className="h-6 w-6 fill-orange-500/20" />
            </div>
            <div>
              <span class="text-xs font-bold text-[#b25e00] uppercase tracking-wider block">Current Streak</span>
              <span class="text-2xl font-bold font-serif text-[#181715] mt-0.5 block">
                {currentStreak} {currentStreak === 1 ? "day" : "days"}
              </span>
            </div>
          </div>

          <!-- Max Streak Card -->
          <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-5 shadow-sm flex items-center gap-4">
            <div class="h-12 w-12 rounded-full bg-[#cc785c]/10 border border-[#cc785c]/20 flex items-center justify-center text-[#cc785c]">
              <Award className="h-6 w-6 fill-[#cc785c]/15" />
            </div>
            <div>
              <span class="text-xs font-bold text-[#6c6a64] uppercase tracking-wider block">Max Streak</span>
              <span class="text-2xl font-bold font-serif text-[#181715] mt-0.5 block">
                {maxStreak} {maxStreak === 1 ? "day" : "days"}
              </span>
            </div>
          </div>
        </div>

        <!-- Problem Solving Progress Card -->
        <div class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 shadow-sm">
          <div class="flex items-center justify-between border-b border-[#e6dfd8] pb-4 mb-6">
            <h3 class="text-lg font-bold font-serif text-[#141413]">Problem Solving Progress</h3>
            <span class="text-sm font-mono text-[#6c6a64] font-medium">
              Solved {solvedCount.TOTAL} / {totalCount.TOTAL}
            </span>
          </div>

          <!-- Overall Progress Bar -->
          <div class="mb-8">
            <div class="flex justify-between text-xs font-bold uppercase tracking-wider text-[#6c6a64] mb-1.5">
              <span>Overall Completion</span>
              <span>{totalPct}%</span>
            </div>
            <div class="w-full h-3 bg-[#efe9de] rounded-full overflow-hidden border border-[#e6dfd8]/50">
              <div class="h-full bg-gradient-to-r from-amber-500 to-[#cc785c] rounded-full transition-all duration-500" style={`width: ${totalPct}%`}></div>
            </div>
          </div>

          <!-- Difficulty Progress Bars -->
          <div class="space-y-5">
            <!-- Easy Progress -->
            <div>
              <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                <span class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#5db872]"></span>
                  <span class="font-bold text-[#2e7d32] uppercase tracking-wider text-[11px]">Easy Problems</span>
                </span>
                <span class="font-mono text-[#6c6a64]">
                  {solvedCount.EASY} / {totalCount.EASY} <span class="text-xs text-[#8e8b82] ml-1">({easyPct}%)</span>
                </span>
              </div>
              <div class="w-full h-2 bg-[#5db872]/10 rounded-full overflow-hidden border border-[#5db872]/20">
                <div class="h-full bg-[#5db872] rounded-full transition-all duration-500" style={`width: ${easyPct}%`}></div>
              </div>
            </div>

            <!-- Medium Progress -->
            <div>
              <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                <span class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#e8a55a]"></span>
                  <span class="font-bold text-[#b26a00] uppercase tracking-wider text-[11px]">Medium Problems</span>
                </span>
                <span class="font-mono text-[#6c6a64]">
                  {solvedCount.MEDIUM} / {totalCount.MEDIUM} <span class="text-xs text-[#8e8b82] ml-1">({mediumPct}%)</span>
                </span>
              </div>
              <div class="w-full h-2 bg-[#e8a55a]/10 rounded-full overflow-hidden border border-[#e8a55a]/20">
                <div class="h-full bg-[#e8a55a] rounded-full transition-all duration-500" style={`width: ${mediumPct}%`}></div>
              </div>
            </div>

            <!-- Hard Progress -->
            <div>
              <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                <span class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#c64545]"></span>
                  <span class="font-bold text-[#c64545] uppercase tracking-wider text-[11px]">Hard Problems</span>
                </span>
                <span class="font-mono text-[#6c6a64]">
                  {solvedCount.HARD} / {totalCount.HARD} <span class="text-xs text-[#8e8b82] ml-1">({hardPct}%)</span>
                </span>
              </div>
              <div class="w-full h-2 bg-[#c64545]/10 rounded-full overflow-hidden border border-[#c64545]/20">
                <div class="h-full bg-[#c64545] rounded-full transition-all duration-500" style={`width: ${hardPct}%`}></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
