---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '@/lib/db';
import { PracticeGroup } from '@prisma/client';

import { getTopicIcon } from '@/lib/practice/icons';

const topics = await prisma.practiceTopic.findMany({
  orderBy: {
    name: 'asc'
  },
  include: {
    sets: {
      select: {
        _count: {
          select: {
            questions: true
          }
        }
      }
    }
  }
});

// Group topics by their respective PracticeGroup
const groups = {
  APTITUDE: [] as any[],
  LOGICAL_REASONING: [] as any[],
  VERBAL_REASONING: [] as any[],
  NONVERBAL_REASONING: [] as any[]
};

topics.forEach(topic => {
  const setsCount = topic.sets.length;
  const questionsCount = topic.sets.reduce((sum, set) => sum + set._count.questions, 0);
  
  const processedTopic = {
    ...topic,
    setsCount,
    questionsCount
  };

  if (topic.group === PracticeGroup.APTITUDE) {
    groups.APTITUDE.push(processedTopic);
  } else if (topic.group === PracticeGroup.LOGICAL_REASONING) {
    groups.LOGICAL_REASONING.push(processedTopic);
  } else if (topic.group === PracticeGroup.VERBAL_REASONING) {
    groups.VERBAL_REASONING.push(processedTopic);
  } else if (topic.group === PracticeGroup.NONVERBAL_REASONING) {
    groups.NONVERBAL_REASONING.push(processedTopic);
  }
});

const formatGroupHeading = (group: string) => {
  switch (group) {
    case 'APTITUDE': return 'Aptitude';
    case 'LOGICAL_REASONING': return 'Logical Reasoning';
    case 'VERBAL_REASONING': return 'Verbal Reasoning';
    case 'NONVERBAL_REASONING': return 'Non-Verbal Reasoning';
    default: return group;
  }
};

// Global index counter for card animation-delay
let cardIndex = 0;
---

<Layout title="Aptitude & Reasoning Practice Tests | RiddlesMaster" description="Prepare for job assessments with our free aptitude tests, verbal reasoning tests, quantitative reasoning, and non-verbal reasoning practice questions.">
  <main class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight font-serif text-[#141413]">Practice</h1>
      <p class="mt-2 text-[#3d3d3a]">Prepare for placements and technical interviews with topic-wise MCQ practice</p>
    </div>

    <div class="flex flex-col md:flex-row gap-8 items-start">
      <!-- Sidebar Navigation -->
      <aside class="w-full md:w-[260px] md:sticky md:top-24 flex-shrink-0">
        <div class="border-b md:border-b-0 md:border-r border-[#e6dfd8] pb-4 md:pb-0 md:pr-6">
          <h3 class="hidden md:block text-xs font-semibold uppercase tracking-wider text-[#6c6a64] mb-4 font-sans">
            Categories
          </h3>
          <nav class="flex md:flex-col gap-1 overflow-x-auto md:overflow-x-visible no-scrollbar -mx-6 px-6 md:mx-0 md:px-0">
            {Object.entries(groups).map(([groupKey, groupTopics]) => (
              groupTopics.length > 0 && (
                <button
                  type="button"
                  class="category-tab whitespace-nowrap flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-medium transition-all text-[#6c6a64] hover:text-[#141413] hover:bg-[#f5f0e8] cursor-pointer text-left w-full"
                  data-category={groupKey}
                >
                  <span>{formatGroupHeading(groupKey)}</span>
                  <span class="category-badge hidden md:inline-flex ml-2 text-xs bg-[#f5f0e8] text-[#6c6a64] px-2 py-0.5 rounded-full font-sans">
                    {groupTopics.length}
                  </span>
                </button>
              )
            ))}
          </nav>
        </div>
      </aside>

      <!-- Topics Content Grid -->
      <div class="flex-1 w-full">
        {Object.entries(groups).map(([groupKey, groupTopics]) => (
          groupTopics.length > 0 && (
            <div class="category-section mb-12 hidden" data-category={groupKey}>
              <h2 class="text-2xl font-semibold tracking-tight text-[#141413] mb-6 border-b border-[#e6dfd8] pb-2 font-serif md:hidden">
                {formatGroupHeading(groupKey)}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {groupTopics.map((topic) => {
                  const currentCardIndex = cardIndex++;
                  return (
                    <a 
                      href={`/practice/${topic.slug}`} 
                      class="group flex flex-col bg-white border border-[#e6dfd8] rounded-2xl cursor-pointer p-5 transition-all duration-200 hover:shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:border-[#cc785c]/40 hover:-translate-y-0.5 practice-card min-h-[190px]"
                      style={`--card-index: ${currentCardIndex};`}
                      id={`topic-card-${topic.slug}`}
                    >
                      {/* Top row: Icon Container */}
                      <div 
                        style={`background-color: ${topic.color || '#FFF3E0'}22;`} 
                        class="w-12 h-12 rounded-xl flex items-center justify-center text-[#181715] transition-transform group-hover:scale-105 duration-200 border border-[#e6dfd8]/30"
                      >
                        <Fragment set:html={getTopicIcon(topic.slug)} />
                      </div>

                      {/* Middle: Title & Description */}
                      <div class="mt-4 flex-1 flex flex-col justify-between">
                        <div>
                          <h3 class="font-semibold text-base text-[#141413] group-hover:text-[#cc785c] transition-colors leading-tight font-serif">
                            {topic.name}
                          </h3>
                          <p class="text-xs text-[#6c6a64] mt-2 font-sans leading-relaxed">
                            {topic.description || `Prepare with topic-wise practice questions on ${topic.name}`}
                          </p>
                        </div>

                        {/* Footer stats */}
                        <div class="flex items-center gap-2 mt-4 pt-3 border-t border-[#e6dfd8]/50 text-xs text-[#6c6a64]">
                          <span class="inline-flex items-center gap-1 font-medium font-sans">
                            <svg class="w-3.5 h-3.5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            {topic.questionsCount} Questions
                          </span>
                          <span class="text-[#e6dfd8]">|</span>
                          <span class="inline-flex items-center gap-1 font-medium font-sans">
                            <svg class="w-3.5 h-3.5 text-[#cc785c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                            {topic.setsCount} Sets
                          </span>
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .practice-card {
      animation: fadeSlideUp 400ms ease-out both;
      animation-delay: calc(var(--card-index) * 40ms);
    }
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll('.category-tab');
    const sections = document.querySelectorAll('.category-section');
    if (tabs.length === 0) return;

    // Helper to activate a tab
    function activateTab(categoryKey) {
      tabs.forEach(tab => {
        const isCurrent = tab.getAttribute('data-category') === categoryKey;
        if (isCurrent) {
          tab.classList.remove('text-[#6c6a64]', 'hover:text-[#141413]', 'hover:bg-[#f5f0e8]');
          tab.classList.add('bg-[#cc785c]', 'text-white');
          // Update the count badge inside the active button
          const badge = tab.querySelector('.category-badge');
          if (badge) {
            badge.classList.remove('bg-[#f5f0e8]', 'text-[#6c6a64]');
            badge.classList.add('bg-white/20', 'text-white');
          }
        } else {
          tab.classList.add('text-[#6c6a64]', 'hover:text-[#141413]', 'hover:bg-[#f5f0e8]');
          tab.classList.remove('bg-[#cc785c]', 'text-white');
          const badge = tab.querySelector('.category-badge');
          if (badge) {
            badge.classList.add('bg-[#f5f0e8]', 'text-[#6c6a64]');
            badge.classList.remove('bg-white/20', 'text-white');
          }
        }
      });

      sections.forEach(section => {
        const isCurrent = section.getAttribute('data-category') === categoryKey;
        if (isCurrent) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      // Update URL search parameters without reloading
      const url = new URL(window.location.href);
      url.searchParams.set('category', categoryKey.toLowerCase());
      window.history.replaceState({}, '', url.toString());
      localStorage.setItem('practice_active_category', categoryKey);
    }

    // Set initial active tab (from URL query param, then localStorage, defaulting to APTITUDE)
    const urlParams = new URLSearchParams(window.location.search);
    const queryCategory = urlParams.get('category');
    
    let initialCategory = 'APTITUDE';
    if (queryCategory) {
      const match = Array.from(tabs).find(t => t.getAttribute('data-category').toLowerCase() === queryCategory.toLowerCase());
      if (match) {
        initialCategory = match.getAttribute('data-category');
      }
    } else {
      const savedCategory = localStorage.getItem('practice_active_category');
      if (savedCategory && Array.from(tabs).some(t => t.getAttribute('data-category') === savedCategory)) {
        initialCategory = savedCategory;
      }
    }

    activateTab(initialCategory);

    // Bind click listeners
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category');
        activateTab(cat);
      });
    });
  });
</script>
