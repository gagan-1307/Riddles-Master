---
import Layout from "../../../layouts/Layout.astro";
import AdminLayout from "../../../app/admin/layout";
import { prisma } from "../../../lib/db";
import { getUser } from "../../../lib/auth/getUser";
import { PracticeGroup } from "@prisma/client";

// Authenticate user
const dbUser = await getUser(Astro.cookies, Astro.locals.user);
const _user = Astro.locals.user || dbUser;
const role = Astro.locals.role || (dbUser ? dbUser.role : "guest");
const isAdmin = String(role).toLowerCase() === "admin";

if (!isAdmin) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let topics: any[] = [];
if (isAdmin) {
  topics = await prisma.practiceTopic.findMany({
    orderBy: { name: "asc" }
  });
}

const aptitudeTopics = topics.filter(t => t.group === PracticeGroup.APTITUDE);
const logicalTopics = topics.filter(t => t.group === PracticeGroup.LOGICAL_REASONING);
const verbalTopics = topics.filter(t => t.group === PracticeGroup.VERBAL_REASONING);
const nonVerbalTopics = topics.filter(t => t.group === PracticeGroup.NONVERBAL_REASONING);
---

{
  !isAdmin ? (
    <Layout title="Page Not Found | RiddlesMaster">
      <main class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#faf9f5] px-6 py-24 text-center">
        <div class="w-full max-w-[600px]">
          <h1 class="font-serif text-8xl font-normal tracking-[-0.04em] text-[#141413]/10">404</h1>
          <h2 class="mt-4 font-serif text-3xl font-normal tracking-[-0.03em] text-[#141413] sm:text-4xl">
            Lost in the labyrinth
          </h2>
          <p class="mt-6 text-[16px] leading-relaxed text-[#3d3d3a] max-w-[480px] w-full mx-auto font-sans">
            The page you seek is currently out of reach.
          </p>
          <div class="mt-10">
            <a
              href="/"
              class="inline-flex h-10 items-center justify-center rounded-[8px] border border-[#e6dfd8] bg-[#faf9f5] px-6 text-[14px] font-semibold text-[#141413] transition-all hover:bg-[#efe9de]/30 decoration-none"
            >
              Go Back Home
            </a>
          </div>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="Upload Practice Questions | RiddlesMaster" hideNavbar={true}>
      <AdminLayout currentPath="/admin/practice/upload" userRole={role} client:load>
        <div class="space-y-6 font-sans">
          <div class="flex flex-col gap-1.5 border-b border-[#e6dfd8] pb-5">
            <h2 class="text-2xl font-bold font-serif text-[#141413]">Upload Practice Questions</h2>
            <p class="text-sm text-[#6c6a64]">Add a new practice set using a CSV question list template.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Panel: Form & Rules (5 cols) -->
            <div class="lg:col-span-5 space-y-6">
              <form id="upload-form" class="bg-white border border-[#e6dfd8] rounded-xl p-6 shadow-sm space-y-4">
                <!-- Topic Selection -->
                <div>
                  <label for="topic-select" class="block text-xs font-bold text-[#8e8b82] uppercase tracking-wider mb-1.5">
                    Topic
                  </label>
                  <select
                    id="topic-select"
                    required
                    class="w-full h-10 px-3 rounded-lg border border-[#e6dfd8] bg-[#faf9f5] text-sm text-[#141413] focus:border-[#cc785c] focus:outline-none cursor-pointer"
                  >
                    <option value="" disabled selected>Select a practice topic...</option>
                    {aptitudeTopics.length > 0 && (
                      <optgroup label="Aptitude">
                        {aptitudeTopics.map(t => <option value={t.id}>{t.name}</option>)}
                      </optgroup>
                    )}
                    {logicalTopics.length > 0 && (
                      <optgroup label="Logical Reasoning">
                        {logicalTopics.map(t => <option value={t.id}>{t.name}</option>)}
                      </optgroup>
                    )}
                    {verbalTopics.length > 0 && (
                      <optgroup label="Verbal Reasoning">
                        {verbalTopics.map(t => <option value={t.id}>{t.name}</option>)}
                      </optgroup>
                    )}
                    {nonVerbalTopics.length > 0 && (
                      <optgroup label="Non-Verbal Reasoning">
                        {nonVerbalTopics.map(t => <option value={t.id}>{t.name}</option>)}
                      </optgroup>
                    )}
                  </select>
                </div>

                <!-- Set Number & Set Title -->
                <div class="grid grid-cols-3 gap-3">
                  <div class="col-span-1">
                    <label for="set-number" class="block text-xs font-bold text-[#8e8b82] uppercase tracking-wider mb-1.5">
                      Set #
                    </label>
                    <input
                      type="number"
                      id="set-number"
                      min="1"
                      required
                      placeholder="e.g. 1"
                      class="w-full h-10 px-3 rounded-lg border border-[#e6dfd8] bg-[#faf9f5] text-sm text-[#141413] focus:border-[#cc785c] focus:outline-none"
                    />
                  </div>
                  <div class="col-span-2">
                    <label for="set-title" class="block text-xs font-bold text-[#8e8b82] uppercase tracking-wider mb-1.5">
                      Set Title
                    </label>
                    <input
                      type="text"
                      id="set-title"
                      required
                      placeholder="e.g. Bayes Theorem Intro"
                      class="w-full h-10 px-3 rounded-lg border border-[#e6dfd8] bg-[#faf9f5] text-sm text-[#141413] focus:border-[#cc785c] focus:outline-none"
                    />
                  </div>
                </div>

                <!-- CSV Upload Drag-and-drop zone -->
                <div>
                  <label class="block text-xs font-bold text-[#8e8b82] uppercase tracking-wider mb-1.5">
                    CSV File Template
                  </label>
                  <input
                    type="file"
                    id="csv-file-input"
                    accept=".csv"
                    class="hidden"
                  />
                  <div
                    id="drop-zone"
                    class="border-2 border-dashed border-[#e6dfd8] rounded-xl p-8 text-center bg-[#faf9f5] hover:bg-[#faf9f5]/80 transition-colors cursor-pointer select-none"
                  >
                    <div class="text-3xl text-zinc-400 mb-2">📄</div>
                    <p class="text-xs font-medium text-[#141413]" id="file-label-text">
                      Drag & Drop CSV file here or click to browse
                    </p>
                    <p class="text-[10px] text-zinc-500 mt-1">.csv files only</p>
                  </div>
                </div>
              </form>

              <!-- Rules & Format Panel -->
              <div class="bg-[#faf9f5] border border-[#e6dfd8] rounded-xl p-5 text-xs text-[#6c6a64] space-y-3.5">
                <h4 class="font-bold text-[#141413] uppercase tracking-wider text-[10px]">
                  CSV Upload Instructions & Formatting
                </h4>
                <ul class="space-y-1.5 list-none p-0">
                  <li class="flex items-start gap-1.5">
                    <span class="text-green-600 font-bold">✓</span>
                    <span>Any number of questions (minimum 1, no upper limit)</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-green-600 font-bold">✓</span>
                    <span>correctOption must be A, B, C, or D (case-insensitive)</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-green-600 font-bold">✓</span>
                    <span>All 7 fields required for every row</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-green-600 font-bold">✓</span>
                    <span>Wrap cell values containing commas or quotes in double quotes</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-red-600 font-bold">✗</span>
                    <span>First row must contain EXACTLY the header labels shown below</span>
                  </li>
                </ul>

                <div>
                  <span class="font-semibold text-[10px] text-[#8e8b82] uppercase block mb-1">CSV Template Format</span>
                  <pre class="bg-zinc-900 text-zinc-100 p-3 rounded-lg overflow-x-auto font-mono text-[9px] leading-relaxed select-all">statement,optionA,optionB,optionC,optionD,correctOption,solution
"What is 20% of 150?","25","30","35","40","B","20% of 150 = 0.2×150 = 30"</pre>
                </div>
              </div>
            </div>

            <!-- Right Panel: Preview Table (7 cols) -->
            <div class="lg:col-span-7 space-y-4">
              <div id="preview-placeholder" class="bg-white border border-[#e6dfd8] rounded-xl p-16 text-center shadow-sm">
                <div class="text-4xl text-zinc-300 mb-2">👁️</div>
                <h4 class="text-sm font-bold text-[#141413] mb-1">Set Preview Console</h4>
                <p class="text-xs text-zinc-500 max-w-[280px] mx-auto leading-relaxed">
                  Select a topic, fill set information, and drag your CSV file to view question validation rules here.
                </p>
              </div>

              <!-- Real Preview Panel -->
              <div id="preview-panel" class="hidden space-y-4">
                <div class="flex items-center justify-between border-b border-[#e6dfd8] pb-3">
                  <h3 class="text-sm font-bold text-[#141413]" id="preview-summary-text">
                    0 questions ready to upload
                  </h3>
                  <button
                    type="button"
                    id="submit-upload-btn"
                    disabled
                    class="inline-flex h-9 items-center justify-center rounded-[8px] bg-[#cc785c] disabled:bg-[#efe9de] disabled:text-[#8e8b82] disabled:cursor-not-allowed px-5 text-xs font-semibold text-white shadow-md transition-all hover:bg-[#a9583e] active:scale-[0.98] cursor-pointer"
                  >
                    Upload Questions
                  </button>
                </div>

                <div class="overflow-x-auto border border-[#e6dfd8] rounded-lg max-h-[500px]">
                  <table class="w-full text-xs font-sans bg-white border-collapse">
                    <thead>
                      <tr class="border-b border-[#e6dfd8] bg-[#faf9f5] text-[10px] font-bold tracking-wider text-[#8e8b82] uppercase text-left">
                        <th class="p-2.5 text-center w-8">#</th>
                        <th class="p-2.5">Statement</th>
                        <th class="p-2.5">A</th>
                        <th class="p-2.5">B</th>
                        <th class="p-2.5">C</th>
                        <th class="p-2.5">D</th>
                        <th class="p-2.5 text-center w-12">Ans</th>
                        <th class="p-2.5">Solution</th>
                      </tr>
                    </thead>
                    <tbody id="preview-tbody">
                      <!-- Rendered by JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </AdminLayout>
    </Layout>
  )
}

<!-- Toast integration inside Layout, use window.toast or similar if present -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // DOM elements
    const topicSelect = document.getElementById('topic-select');
    const setNumberInput = document.getElementById('set-number');
    const setTitleInput = document.getElementById('set-title');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('csv-file-input');
    const fileLabelText = document.getElementById('file-label-text');
    const previewPlaceholder = document.getElementById('preview-placeholder');
    const previewPanel = document.getElementById('preview-panel');
    const previewSummaryText = document.getElementById('preview-summary-text');
    const previewTbody = document.getElementById('preview-tbody');
    const submitUploadBtn = document.getElementById('submit-upload-btn');

    let parsedQuestions = [];
    let hasValidationErrors = false;

    // 1. Fetch next set number on topic selection change
    topicSelect?.addEventListener('change', async (e) => {
      const topicId = e.target.value;
      if (!topicId) return;

      try {
        const res = await fetch(`/api/admin/practice/next-set-number?topicId=${topicId}`);
        if (res.ok) {
          const data = await res.json();
          if (setNumberInput) {
            setNumberInput.value = data.nextSetNumber;
          }
        }
      } catch (err) {
        console.error('Error fetching next set number:', err);
      }
    });

    // 2. Click to browse file input trigger
    dropZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    // File Drag-Over highlights
    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('bg-[#efe9de]/30', 'border-[#cc785c]');
    });

    dropZone?.addEventListener('dragleave', () => {
      dropZone.classList.remove('bg-[#efe9de]/30', 'border-[#cc785c]');
    });

    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('bg-[#efe9de]/30', 'border-[#cc785c]');
      
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) {
        handleFileSelect(files[0]);
      }
    });

    fileInput?.addEventListener('change', (e) => {
      const files = e.target.files;
      if (files && files.length > 0) {
        handleFileSelect(files[0]);
      }
    });

    // 3. Load and parse selected CSV file
    function handleFileSelect(file) {
      if (!file.name.endsWith('.csv')) {
        alert('Invalid file format. Please upload a .csv file.');
        return;
      }

      fileLabelText.textContent = `Selected: ${file.name}`;
      
      const reader = new FileReader();
      reader.onload = (e) => {
        const text = e.target.result;
        processCSVText(text);
      };
      reader.readAsText(file);
    }

    // 4. Client-side manual CSV parser
    function parseCSV(text) {
      const lines = [];
      let row = [];
      let col = "";
      let insideQuote = false;

      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];

        if (char === '"') {
          if (insideQuote && nextChar === '"') {
            col += '"';
            i++; // skip next quote
          } else {
            insideQuote = !insideQuote;
          }
        } else if (char === ',' && !insideQuote) {
          row.push(col);
          col = "";
        } else if ((char === '\r' || char === '\n') && !insideQuote) {
          row.push(col);
          if (row.length > 1 || row[0] !== "") {
            lines.push(row);
          }
          row = [];
          col = "";
          if (char === '\r' && nextChar === '\n') {
            i++; // skip \n of \r\n
          }
        } else {
          col += char;
        }
      }
      if (col !== "" || row.length > 0) {
        row.push(col);
        lines.push(row);
      }
      return lines;
    }

    // 5. Parse, Validate, and Preview
    function processCSVText(text) {
      const rawRows = parseCSV(text);
      if (rawRows.length < 2) {
        alert('CSV file is empty or missing data rows.');
        return;
      }

      // Check header values
      const headers = rawRows[0].map(h => h.trim().toLowerCase());
      const expectedHeaders = ['statement', 'optiona', 'optionb', 'optionc', 'optiond', 'correctoption', 'solution'];
      const hasCorrectHeaders = expectedHeaders.every((h, idx) => headers[idx] === h);

      if (!hasCorrectHeaders) {
        alert(`Invalid CSV header format.\nExpected exactly: ${expectedHeaders.join(', ')}`);
        return;
      }

      parsedQuestions = [];
      hasValidationErrors = false;
      previewTbody.innerHTML = '';

      for (let i = 1; i < rawRows.length; i++) {
        const row = rawRows[i];
        
        // Skip entirely blank rows
        if (row.length === 1 && row[0].trim() === '') continue;

        const statement = (row[0] || '').trim();
        const optionA = (row[1] || '').trim();
        const optionB = (row[2] || '').trim();
        const optionC = (row[3] || '').trim();
        const optionD = (row[4] || '').trim();
        const correctOption = (row[5] || '').toUpperCase().trim();
        const solution = (row[6] || '').trim();

        const q = { statement, optionA, optionB, optionC, optionD, correctOption, solution };
        parsedQuestions.push(q);

        // Validation checks
        const rowErrors = [];
        if (!statement) rowErrors.push('Missing statement');
        if (!optionA || !optionB || !optionC || !optionD) rowErrors.push('Missing one or more option fields');
        if (!correctOption) {
          rowErrors.push('Missing correctOption');
        } else if (!['A', 'B', 'C', 'D'].includes(correctOption)) {
          rowErrors.push(`Invalid correctOption '${correctOption}' (must be A, B, C, or D)`);
        }
        if (!solution) rowErrors.push('Missing solution');

        const isRowInvalid = rowErrors.length > 0;
        if (isRowInvalid) hasValidationErrors = true;

        // Build preview row HTML
        const tr = document.createElement('tr');
        tr.className = `border-b border-[#e6dfd8] ${isRowInvalid ? 'bg-red-50 text-red-950 font-medium' : 'hover:bg-zinc-50'}`;
        
        tr.innerHTML = `
          <td class="p-2.5 text-center text-zinc-500 font-mono">${i}</td>
          <td class="p-2.5">
            <div class="truncate max-w-[180px]" title="${statement}">${statement || '<span class="italic text-red-500">Empty</span>'}</div>
            ${isRowInvalid ? `<div class="text-[10px] text-red-600 font-semibold mt-0.5">${rowErrors.join(', ')}</div>` : ''}
          </td>
          <td class="p-2.5 truncate max-w-[80px]" title="${optionA}">${optionA || '—'}</td>
          <td class="p-2.5 truncate max-w-[80px]" title="${optionB}">${optionB || '—'}</td>
          <td class="p-2.5 truncate max-w-[80px]" title="${optionC}">${optionC || '—'}</td>
          <td class="p-2.5 truncate max-w-[80px]" title="${optionD}">${optionD || '—'}</td>
          <td class="p-2.5 text-center font-bold text-zinc-800">${correctOption || '—'}</td>
          <td class="p-2.5 truncate max-w-[120px]" title="${solution}">${solution || '—'}</td>
        `;
        previewTbody.appendChild(tr);
      }

      previewSummaryText.textContent = `${parsedQuestions.length} questions ready to upload`;
      previewPlaceholder.classList.add('hidden');
      previewPanel.classList.remove('hidden');

      // Update button state
      updateSubmitButtonState();
    }

    function updateSubmitButtonState() {
      const topicId = topicSelect.value;
      const setNum = setNumberInput.value;
      const title = setTitleInput.value.trim();

      const isValidForm = topicId && setNum && title && parsedQuestions.length > 0 && !hasValidationErrors;
      submitUploadBtn.disabled = !isValidForm;
    }

    // Bind checks to input updates
    [topicSelect, setNumberInput, setTitleInput].forEach(elem => {
      elem?.addEventListener('input', updateSubmitButtonState);
      elem?.addEventListener('change', updateSubmitButtonState);
    });

    // 6. Handle upload action
    submitUploadBtn?.addEventListener('click', async () => {
      const topicId = topicSelect.value;
      const setNumber = parseInt(setNumberInput.value, 10);
      const title = setTitleInput.value.trim();

      if (!topicId || isNaN(setNumber) || !title || parsedQuestions.length === 0 || hasValidationErrors) {
        return;
      }

      submitUploadBtn.disabled = true;
      submitUploadBtn.textContent = 'Uploading...';

      try {
        const res = await fetch('/api/admin/practice/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            topicId,
            setNumber,
            title,
            questions: parsedQuestions
          })
        });

        const data = await res.json();
        
        if (!res.ok) {
          throw new Error(data.error || 'Failed to upload set.');
        }

        // Show Success toast (via global window/sonner toast if possible, otherwise alert fallback)
        if (window.toast) {
          window.toast.success(`Success! Created set #${setNumber}: "${title}" with ${parsedQuestions.length} questions.`);
        } else {
          alert(`Success! Created set #${setNumber}: "${title}" with ${parsedQuestions.length} questions.`);
        }

        // Clear forms
        document.getElementById('upload-form').reset();
        parsedQuestions = [];
        hasValidationErrors = false;
        fileLabelText.textContent = 'Drag & Drop CSV file here or click to browse';
        previewPanel.classList.add('hidden');
        previewPlaceholder.classList.remove('hidden');
        submitUploadBtn.disabled = true;

      } catch (err) {
        console.error('CSV upload failure:', err);
        alert(err.message || 'An error occurred during upload.');
      } finally {
        submitUploadBtn.textContent = 'Upload Questions';
        updateSubmitButtonState();
      }
    });

  });
</script>
