---
import Layout from "../../../../layouts/Layout.astro";
import AdminLayout from "../../../../app/admin/layout";
import EditProblemPage from "../../../../app/admin/problems/[id]/edit/page";
import { prisma } from "../../../../lib/db";
import { getUser } from "../../../../lib/auth/getUser";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

// Authenticate user
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;
const role = Astro.locals.role || (dbUser ? dbUser.role : "guest");

const isAdmin = role === "admin" || role === "ADMIN";

if (!isAdmin) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

// Fetch problem details and all tags only if admin
let problem = null;
let allTags = [];

if (isAdmin) {
  const [problemData, tagsData] = await Promise.all([
    prisma.problem.findUnique({
      where: { id },
      include: {
        tags: {
          include: {
            tag: true
          }
        }
      }
    }),
    prisma.tag.findMany({
      orderBy: {
        name: "asc"
      }
    })
  ]);

  problem = problemData;
  allTags = tagsData;
}

if (isAdmin && !problem) {
  return Astro.redirect("/404");
}
---

{
  !isAdmin ? (
    <Layout title="Page Not Found | RiddlesMaster">
      <main class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#faf9f5] px-6 py-24 text-center">
        <div class="w-full max-w-[600px] animate-in fade-in slide-in-from-bottom-4 duration-700">
          <h1 class="font-serif text-8xl font-normal tracking-[-0.04em] text-[#141413]/10">404</h1>
          <h2 class="mt-4 font-serif text-3xl font-normal tracking-[-0.03em] text-[#141413] sm:text-4xl">
            Lost in the labyrinth
          </h2>
          <p class="mt-6 text-[16px] leading-relaxed text-[#3d3d3a] max-w-[480px] w-full mx-auto font-sans">
            The page you seek is currently out of reach. The page might have been solved, relocated, or never existed in this timeline.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/"
              class="w-full sm:w-auto inline-flex h-10 items-center justify-center rounded-[8px] border border-[#e6dfd8] bg-[#faf9f5] px-6 text-[14px] font-semibold text-[#141413] transition-all hover:bg-[#efe9de]/30 active:scale-[0.98] decoration-none"
            >
              Go Back Home
            </a>
          </div>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title={`Edit Riddle #${problem?.number} | RiddlesMaster`} hideNavbar={true}>
      <AdminLayout currentPath="/admin/problems" userRole={role} client:load>
        <EditProblemPage problem={problem as any} allTags={allTags} client:load />
      </AdminLayout>
    </Layout>
  )
}
