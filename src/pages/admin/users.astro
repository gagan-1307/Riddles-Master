---
import Layout from "../../layouts/Layout.astro";
import AdminLayout from "../../app/admin/layout";
import UsersPage from "../../app/admin/users/page";
import { prisma } from "../../lib/db";
import { getUser } from "../../lib/auth/getUser";

// Authenticate user
const dbUser = await getUser(Astro.cookies);
const user = Astro.locals.user || dbUser;
const role = Astro.locals.role || (dbUser ? dbUser.role : "guest");

const isAdmin = role === "admin" || role === "ADMIN";

if (!isAdmin) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

// Paginated query only if admin
let users = [];
let totalUsers = 0;
let totalPages = 0;
let currentPage = 1;

const PAGE_SIZE = 50;

if (isAdmin) {
  const pageParam = Astro.url.searchParams.get("page");
  currentPage = parseInt(pageParam || "1", 10);
  if (isNaN(currentPage) || currentPage < 1) {
    currentPage = 1;
  }

  const skip = (currentPage - 1) * PAGE_SIZE;

  const [usersData, totalCount] = await Promise.all([
    prisma.user.findMany({
      skip,
      take: PAGE_SIZE,
      orderBy: {
        createdAt: "desc"
      },
      include: {
        subscription: true
      }
    }),
    prisma.user.count()
  ]);

  users = usersData;
  totalUsers = totalCount;
  totalPages = Math.ceil(totalCount / PAGE_SIZE);
}
---

{
  !isAdmin ? (
    <Layout title="Page Not Found | RiddlesMaster">
      <main class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#faf9f5] px-6 py-24 text-center font-sans">
        <div class="w-full max-w-[600px] animate-in fade-in slide-in-from-bottom-4 duration-700">
          <h1 class="font-serif text-8xl font-normal tracking-[-0.04em] text-[#141413]/10">404</h1>
          <h2 class="mt-4 font-serif text-3xl font-normal tracking-[-0.03em] text-[#141413] sm:text-4xl">
            Lost in the labyrinth
          </h2>
          <p class="mt-6 text-[16px] leading-relaxed text-[#3d3d3a] max-w-[480px] w-full mx-auto">
            The page you seek is currently out of reach. The page might have been solved, relocated, or never existed in this timeline.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/"
              class="w-full sm:w-auto inline-flex h-10 items-center justify-center rounded-[8px] border border-[#e6dfd8] bg-[#faf9f5] px-6 text-[14px] font-semibold text-[#141413] transition-all hover:bg-[#efe9de]/30 active:scale-[0.98] decoration-none"
            >
              Go Back Home
            </a>
          </div>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="User Directory | RiddlesMaster" hideNavbar={true}>
      <AdminLayout currentPath="/admin/users" userRole={role} client:load>
        <UsersPage 
          users={users as any} 
          currentPage={currentPage} 
          totalPages={totalPages} 
          totalUsers={totalUsers} 
          client:load 
        />
      </AdminLayout>
    </Layout>
  )
}
