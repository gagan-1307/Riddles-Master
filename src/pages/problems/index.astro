---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ProblemsPage from '../../app/problems/page';
import { ErrorBoundary } from '../../app/problems/error';
import { getAllProblems } from '../../lib/problems';
import { getUser } from '../../lib/auth/getUser';

const problems = await getAllProblems();

// Check user session via getUser helper (includes subscription relation)
const dbUser = await getUser(Astro.cookies);
const role = Astro.locals.role || (dbUser ? dbUser.role : "guest");

// Check premium status directly from the user's fetched subscription object to avoid extra query
const isUserPremium = !!(
  dbUser?.subscription &&
  dbUser.subscription.status === "ACTIVE" &&
  new Date(dbUser.subscription.endDate) > new Date()
);
const isAdmin = String(role).toLowerCase() === "admin";
const hasPremiumAccess = isUserPremium || isAdmin;
---

<Layout title="All Problems | RiddlesMaster">
  <main class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight font-serif text-[#141413]">Practice Problems</h1>
      <p class="mt-2 text-[#3d3d3a]">Master the art of lateral thinking with {problems.length} curated riddles.</p>
    </div>
    
    <ErrorBoundary client:load>
      <ProblemsPage initialProblems={problems} hasPremiumAccess={hasPremiumAccess} client:load />
    </ErrorBoundary>
  </main>
</Layout>
