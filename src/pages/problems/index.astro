---
import Layout from '../../layouts/Layout.astro';
import ProblemsPage from '../../app/problems/page';
import { getAllProblems } from '../../lib/problems';

const problems = await getAllProblems();
---

<Layout title="All Problems | RiddlesMaster">
  <main class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight font-serif text-[#141413]">Practice Problems</h1>
      <p class="mt-2 text-[#3d3d3a]">Master the art of lateral thinking with {problems.length} curated riddles.</p>
    </div>
    
    <ProblemsPage initialProblems={problems} client:load />
  </main>
</Layout>
