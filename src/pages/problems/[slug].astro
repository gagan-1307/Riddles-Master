---
import Layout from "../../layouts/Layout.astro";
import { prisma } from "../../lib/db";
import { getProblemBySlug } from "../../lib/problems";
import { getUser } from "../../lib/auth/getUser";
import { checkPremium } from "../../lib/auth/checkPremium";
import LoginPrompt from "../../components/LoginPrompt.astro";
import UpgradeCTA from "../../components/UpgradeCTA.astro";
import LikeButton from "../../components/LikeButton";
import SolveButton from "../../components/SolveButton";
import { Lock, ArrowLeft } from "lucide-react";

// Required for SSR / getStaticPaths if Astro prerendering is triggered, but since output is 'server',
// getStaticPaths is still useful for static analysis or if dynamic routing fallbacks are configured.
export async function getStaticPaths() {
  const problems = await prisma.problem.findMany({
    select: { slug: true },
  });
  return problems.map((problem) => ({
    params: { slug: problem.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// Fetch problem details
const problem = await getProblemBySlug(slug);

if (!problem) {
  return Astro.redirect("/404");
}

// Get user session via getUser helper
const dbUser = await getUser(Astro.cookies);
const _user = Astro.locals.user || dbUser;
const role = Astro.locals.role || (dbUser ? dbUser.role : "guest");

// Check premium status
const isUserPremium = dbUser ? await checkPremium(dbUser.id) : false;
const isAdmin = String(role).toLowerCase() === "admin";
const hasPremiumAccess = isUserPremium || isAdmin;

// Get Like / Solve status
const isLiked = dbUser
  ? (await prisma.likedProblem.findUnique({
      where: {
        userId_problemId: {
          userId: dbUser.id,
          problemId: problem.id,
        },
      },
    })) !== null
  : false;

const problemStatus = dbUser
  ? await prisma.userProblemStatus.findUnique({
      where: {
        userId_problemId: {
          userId: dbUser.id,
          problemId: problem.id,
        },
      },
    })
  : null;
const isSolved = problemStatus ? problemStatus.solved : false;

// Likes count
const likesCount = await prisma.likedProblem.count({
  where: { problemId: problem.id },
});

const companyTags = problem.tags.filter(({ tag }) => tag.type === "COMPANY");
const typeTags = problem.tags.filter(({ tag }) => tag.type === "TYPE");

const getDifficultyStyles = (difficulty: string) => {
  switch (difficulty) {
    case "EASY":
      return "bg-[#5db872]/10 text-[#2e7d32] border border-[#5db872]/20";
    case "MEDIUM":
      return "bg-[#e8a55a]/10 text-[#b26a00] border border-[#e8a55a]/20";
    case "HARD":
      return "bg-[#c64545]/10 text-[#c64545] border border-[#c64545]/20";
    default:
      return "bg-gray-100 text-gray-800";
  }
};

const metaTitle = `Problem #${problem.number} — ${problem.title} | Interview Riddle`;
const metaDescription =
  problem.statement.substring(0, 160).replace(/\r?\n|\r/g, " ") + "...";
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
---

<Layout title={metaTitle} description={metaDescription}>
  <head slot="head">
    <!-- OpenGraph Metadata -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
  </head>

  <main class="mx-auto max-w-[900px] px-6 py-12">
    <!-- Breadcrumb Nav & Action Row -->
    <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
      <nav
        class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#6c6a64]"
      >
        <a href="/problems" class="hover:text-[#cc785c] transition-colors"
          >Problems</a
        >
        <span class="text-[#e6dfd8]">&gt;</span>
        <span class="text-[#3d3d3a] truncate max-w-[200px] sm:max-w-none"
          >{problem.title}</span
        >
      </nav>

      <a
        href="/problems"
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-[#cc785c] hover:text-[#a9583e] hover:underline transition-colors"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        All Problems
      </a>
    </div>

    <!-- Header Card -->
    <div
      class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 mb-8 shadow-sm"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-6 border-b border-[#e6dfd8] pb-6 mb-6"
      >
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="font-mono text-sm font-bold text-[#6c6a64]"
              >Problem #{problem.number}</span
            >
            <span
              class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ${getDifficultyStyles(problem.difficulty)}`}
            >
              {problem.difficulty}
            </span>
            {
              problem.isPremium && (
                <span class="inline-flex items-center gap-1 rounded-full bg-[#cc785c]/10 px-2.5 py-0.5 text-xs font-bold text-[#cc785c] border border-[#cc785c]/20">
                  <Lock className="h-3 w-3" /> Premium
                </span>
              )
            }
          </div>
          <h1
            class="text-3xl sm:text-4xl font-bold font-serif text-[#141413] mt-2"
          >
            {problem.title}
          </h1>
        </div>

        <!-- Action buttons (Like & Solve) -->
        <div class="flex items-center gap-3">
          <LikeButton
            problemId={problem.id}
            initialLiked={isLiked}
            initialLikesCount={likesCount}
            client:load
          />
          <SolveButton
            problemId={problem.id}
            initialSolved={isSolved}
            client:load
          />
        </div>
      </div>

      <!-- Tags list -->
      <div class="flex flex-wrap gap-2">
        {
          companyTags.map(({ tag }) => (
            <span class="inline-flex items-center rounded-full bg-[#cc785c]/10 px-2.5 py-0.5 text-xs font-medium text-[#cc785c] border border-[#cc785c]/20">
              {tag.name}
            </span>
          ))
        }
        {
          typeTags.map(({ tag }) => (
            <span class="inline-flex items-center rounded-full bg-[#efe9de] px-2.5 py-0.5 text-xs font-medium text-[#141413] border border-[#e6dfd8]">
              {tag.name}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Content Area -->
    <div class="space-y-8">
      <!-- Problem Statement -->
      {
        !problem.isPremium || hasPremiumAccess ? (
          <section class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 shadow-sm">
            <h2 class="text-xl font-bold font-serif text-[#141413] mb-4 border-b border-[#e6dfd8] pb-3">
              Problem Statement
            </h2>
            <div class="prose max-w-none text-[#3d3d3a] leading-relaxed space-y-4 whitespace-pre-line text-[16px]">
              {problem.statement}
            </div>
          </section>
        ) : (
          /* Premium Paywall for Statement */
          <section class="rounded-lg border border-[#cc785c]/30 bg-[#faf9f5] p-8 shadow-sm text-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#faf9f5]/80 pointer-events-none" />
            <div class="relative z-10 py-8 max-w-md mx-auto">
              <div class="mx-auto h-12 w-12 rounded-full bg-[#cc785c]/10 flex items-center justify-center text-[#cc785c] mb-4">
                <Lock className="h-6 w-6" />
              </div>
              <h2 class="text-2xl font-bold font-serif text-[#141413] mb-3">
                Premium Riddle
              </h2>
              <p class="text-[#3d3d3a] text-sm mb-6 leading-relaxed">
                This is a premium brain teaser. Unlock full access to all
                premium interview riddles, detailed step-by-step solutions, and
                company-specific sets with RiddlesMaster Premium.
              </p>
              <a
                href="/pricing"
                class="inline-flex h-10 items-center justify-center rounded-md bg-[#cc785c] px-6 text-sm font-semibold text-white transition-all hover:bg-[#a9583e] active:scale-[0.98] shadow-lg shadow-[#cc785c]/10"
              >
                Upgrade to Premium
              </a>
            </div>
          </section>
        )
      }

      <!-- Answer / Hint Section -->
      {
        (!problem.isPremium || hasPremiumAccess) && (
          <section class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 shadow-sm">
            <h2 class="text-xl font-bold font-serif text-[#141413] mb-4 border-b border-[#e6dfd8] pb-3">
              Answer & Quick Explanation
            </h2>
            {dbUser ? (
              <div class="space-y-4">
                <button
                  id="reveal-answer-btn"
                  class="inline-flex h-9 items-center justify-center rounded-md bg-[#cc785c] px-4 text-xs font-semibold text-white transition-all hover:bg-[#a9583e] active:scale-[0.98] cursor-pointer"
                >
                  Reveal Answer
                </button>
                <div
                  id="answer-content"
                  class="hidden rounded-md border border-[#e6dfd8] bg-[#f5f0e8]/30 p-5 text-[#3d3d3a] leading-relaxed text-[15px]"
                >
                  {problem.answer}
                </div>
              </div>
            ) : (
              <LoginPrompt />
            )}
          </section>
        )
      }

      <!-- Detailed Editorial (Premium Only) -->
      {
        (!problem.isPremium || hasPremiumAccess) && (
          <section class="rounded-lg border border-[#e6dfd8] bg-[#faf9f5] p-8 shadow-sm">
            <h2 class="text-xl font-bold font-serif text-[#141413] mb-4 border-b border-[#e6dfd8] pb-3">
              Detailed Editorial Solution
            </h2>
            {hasPremiumAccess ? (
              <div class="prose max-w-none text-[#3d3d3a] leading-relaxed space-y-4 whitespace-pre-line text-[15px]">
                {problem.editorial}
              </div>
            ) : (
              <UpgradeCTA />
            )}
          </section>
        )
      }
    </div>
  </main>
</Layout>

<script>
  const revealBtn = document.getElementById("reveal-answer-btn");
  const answerContent = document.getElementById("answer-content");
  if (revealBtn && answerContent) {
    revealBtn.addEventListener("click", () => {
      const isHidden = answerContent.classList.contains("hidden");
      if (isHidden) {
        answerContent.classList.remove("hidden");
        revealBtn.textContent = "Hide Answer";
      } else {
        answerContent.classList.add("hidden");
        revealBtn.textContent = "Reveal Answer";
      }
    });
  }
</script>
