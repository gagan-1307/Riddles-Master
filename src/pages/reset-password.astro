---
import Layout from "../layouts/Layout.astro";

// This page receives the token in the URL hash, which is handled client-side in the browser.
---

<Layout title="Reset Password | RiddlesMaster">
  <main class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-canvas-soft p-6">
    <div class="w-full max-w-[400px] animate-in fade-in slide-in-from-bottom-4 duration-700">
      <div class="mb-10 text-center">
        <h1 class="text-3xl font-bold tracking-[-0.06em] text-ink">Set New Password</h1>
        <p class="mt-3 text-[15px] leading-relaxed text-body">
          Please enter and confirm your new password below.
        </p>
      </div>

      <div class="space-y-6">
        <div id="success-box" class="hidden rounded-lg border border-success/20 bg-success/5 p-6 text-center animate-in zoom-in-95 duration-500">
          <p class="text-sm leading-relaxed text-body">Your password has been successfully updated. Redirecting to login...</p>
        </div>

        <form id="reset-form" class="space-y-5">
          <div class="space-y-1.5">
            <label for="password" class="text-xs font-semibold uppercase tracking-wider text-mute">New Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              class="block w-full rounded-md border border-hairline bg-canvas px-4 py-2.5 text-[15px] placeholder-body/30 shadow-inner-sm transition-all focus:border-ink focus:ring-0"
              placeholder="••••••••"
            />
          </div>
          <div class="space-y-1.5">
            <label for="confirm-password" class="text-xs font-semibold uppercase tracking-wider text-mute">Confirm Password</label>
            <input
              id="confirm-password"
              name="confirm-password"
              type="password"
              required
              class="block w-full rounded-md border border-hairline bg-canvas px-4 py-2.5 text-[15px] placeholder-body/30 shadow-inner-sm transition-all focus:border-ink focus:ring-0"
              placeholder="••••••••"
            />
          </div>

          <div id="error-box" class="hidden rounded-md border border-error/20 bg-error/5 p-3 text-sm font-medium text-error animate-in fade-in zoom-in-95 duration-200">
          </div>

          <button
            type="submit"
            class="w-full rounded-md bg-ink py-2.5 text-[15px] font-semibold text-canvas shadow-lg shadow-ink/10 transition-all hover:opacity-90 active:scale-[0.99]"
          >
            Update Password
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { createSupabaseBrowser } from "../lib/supabase/client";

  const supabase = createSupabaseBrowser();
  const form = document.getElementById("reset-form") as HTMLFormElement;
  const errorBox = document.getElementById("error-box") as HTMLDivElement;
  const successBox = document.getElementById("success-box") as HTMLDivElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const confirmInput = document.getElementById("confirm-password") as HTMLInputElement;

  // Listen for recovery state
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      // Recovery mode active
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");
    errorBox.textContent = "";

    const password = passwordInput.value;
    const confirm = confirmInput.value;

    if (password !== confirm) {
      errorBox.textContent = "Passwords do not match.";
      errorBox.classList.remove("hidden");
      return;
    }

    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      errorBox.textContent = error.message;
      errorBox.classList.remove("hidden");
    } else {
      form.classList.add("hidden");
      successBox.classList.remove("hidden");
      setTimeout(() => {
        window.location.href = "/login";
      }, 3000);
    }
  });
</script>
