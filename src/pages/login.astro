---
import Layout from "../layouts/Layout.astro";

const { supabase, user } = Astro.locals;

if (user) {
  return Astro.redirect("/");
}

let errorMsg = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString();
  const password = formData.get("password")?.toString();
  const provider = formData.get("provider")?.toString();

  if (provider === "google") {
    const { data, error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: {
        redirectTo: `${Astro.url.origin}/auth/callback`,
      },
    });

    if (error) {
      errorMsg = error.message;
    } else if (data.url) {
      return Astro.redirect(data.url);
    }
  } else if (email && password) {
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorMsg = error.message;
    } else {
      return Astro.redirect("/problems");
    }
  }
}
---

<Layout title="Log In | RiddlesMaster">
  <main class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-canvas-soft p-6">
    <div class="w-full max-w-[400px] animate-in fade-in slide-in-from-bottom-4 duration-700">
      <div class="mb-10 text-center">
        <h1 class="text-3xl font-bold tracking-[-0.06em] text-ink">Welcome back</h1>
        <p class="mt-3 text-[15px] leading-relaxed text-body">
          Continue your journey to technical mastery.
        </p>
      </div>

      <div class="space-y-6">
        <form method="POST">
          <input type="hidden" name="provider" value="google" />
          <button
            type="submit"
            class="group flex w-full items-center justify-center gap-3 rounded-md border border-hairline bg-canvas py-2.5 text-sm font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.05)] transition-all hover:bg-canvas-soft hover:shadow-md active:scale-[0.98]"
          >
            <svg class="h-5 w-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
            </svg>
            Sign in with Google
          </button>
        </form>

        <div class="relative flex items-center py-2">
          <div class="flex-grow border-t border-hairline"></div>
          <span class="mx-4 flex-shrink text-[11px] font-bold uppercase tracking-widest text-mute">Or</span>
          <div class="flex-grow border-t border-hairline"></div>
        </div>

        <form method="POST" class="space-y-4">
          <div class="space-y-1.5">
            <label for="email" class="text-xs font-semibold uppercase tracking-wider text-mute">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="block w-full rounded-md border border-hairline bg-canvas px-4 py-2.5 text-[15px] placeholder-body/30 shadow-inner-sm transition-all focus:border-ink focus:ring-0"
              placeholder="name@example.com"
            />
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="password" class="text-xs font-semibold uppercase tracking-wider text-mute">Password</label>
              <a href="/forgot-password" class="text-xs font-medium text-link hover:text-link-deep transition-colors">Forgot?</a>
            </div>
            <input
              id="password"
              name="password"
              type="password"
              required
              class="block w-full rounded-md border border-hairline bg-canvas px-4 py-2.5 text-[15px] placeholder-body/30 shadow-inner-sm transition-all focus:border-ink focus:ring-0"
              placeholder="••••••••"
            />
          </div>

          {errorMsg && (
            <div class="rounded-md border border-error/20 bg-error/5 p-3 text-sm font-medium text-error animate-in fade-in zoom-in-95 duration-200">
              {errorMsg}
            </div>
          )}

          <button
            type="submit"
            class="w-full rounded-md bg-ink py-2.5 text-[15px] font-semibold text-canvas shadow-lg shadow-ink/10 transition-all hover:opacity-90 active:scale-[0.99]"
          >
            Sign In
          </button>
        </form>

        <p class="text-center text-[14px] text-body">
          Don't have an account?{" "}
          <a href="/signup" class="font-semibold text-ink transition-colors hover:underline">
            Sign up for free
          </a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .shadow-inner-sm {
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
  }
</style>
